{
  "name": "amsv2",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "ci:install": "bash scripts/ci-install.sh",
    "guard:malware": "node scripts/guard-malware.js",
    "guard:evil-merge": "node scripts/guard-evil-merge.js",
    "guard:persistence": "node scripts/guard-persistence.js",
    "guard:workflows": "node scripts/guard-workflows.js",
    "guard:lockfile": "node scripts/guard-lockfile.js",
    "guard:assets": "node scripts/guard-assets.js",
    "guard:email-registry": "node scripts/guard-email-registry.js",
    "guard:nodemailer": "node scripts/guard-nodemailer.js",
    "guard:verify-manifest": "node scripts/verify-test-manifest.js",
    "guard:all": "node scripts/guard-malware.js && node scripts/guard-persistence.js && node scripts/guard-workflows.js && node scripts/guard-lockfile.js && node scripts/guard-assets.js && node scripts/guard-email-registry.js && node scripts/guard-nodemailer.js",
    "pretest": "npm run guard:all",
    "dev": "node init && npm run guard:all && nodemon .",
    "start": "node init && npm run guard:all && node .",
    "db:baseline": "prisma migrate resolve --applied 0_init",
    "db:status": "prisma migrate status",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:food": "node scripts/select-tests.js --run-vertical food",
    "test:medical": "node scripts/select-tests.js --run-vertical medical",
    "test:rideshare": "node scripts/select-tests.js --run-vertical rideshare",
    "test:jobs": "node scripts/select-tests.js --run-vertical jobs",
    "test:shop": "node scripts/select-tests.js --run-vertical shop",
    "test:raise": "vitest run raise-payout",
    "test:discounts": "vitest run discount",
    "test:tempstay": "vitest run booking-vertical booking-cancel booking-listing-filters booking-host-visibility booking-host-payout",
    "test:vehicles": "vitest run booking-vehicle-capacity booking-capacity booking-cancel booking-listing-filters",
    "test:venues": "vitest run booking-capacity booking-cancel booking-listing-filters",
    "test:int": "vitest run test/integration",
    "test:cov": "vitest run --coverage",
    "dev:docker:up": "node init && docker compose -f docker-compose.dev.yml up -d",
    "dev:docker:down": "node init && docker compose -f docker-compose.dev.yml down",
    "seed:hotels": "node scripts/seed-hotels.js",
    "seed:guest": "node scripts/seed-booking-user.js",
    "seed:demo-accounts": "node scripts/seed-demo-accounts.js",
    "seed:feed-users": "node scripts/seed-feed-users.mjs",
    "seed:engagement-assign": "node scripts/seed-engagement-assign.mjs",
    "seed:verify-accounts": "node scripts/seed-verify-accounts.js",
    "seed:wedding-shop": "node scripts/seed-wedding-shop.js",
    "seed:wedding-vendors": "node scripts/seed-wedding-vendors.js",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:db:push": "DATABASE_URL=postgresql://test:test@127.0.0.1:5433/strug_test prisma db push --skip-generate",
    "sync-email-locales": "node scripts/sync-email-locale-keys.js",
    "translate-email-locales": "node scripts/translate-email-locales.js",
    "sync-api-locales": "node scripts/sync-api-locale-keys.js",
    "translate-api-locales": "node scripts/translate-api-locales.js",
    "locale-coverage": "node scripts/locale-coverage-report.js",
    "fix-strug-brand": "node scripts/fix-strug-brand-locales.js",
    "complete-locales": "node scripts/sync-api-locale-keys.js && node scripts/sync-email-locale-keys.js && node scripts/translate-api-locales.js && node scripts/translate-email-locales.js && node scripts/fix-strug-brand-locales.js && node scripts/locale-coverage-report.js",
    "cron:inventory": "node -e \"import('./utils/cron-inventory.js').then(m => m.logCronInventory())\"",
    "email:inventory": "node -e \"import('./scripts/email-template-registry.js').then(m => m.logEmailTemplateInventory())\"",
    "email:inventory:md": "node scripts/generate-mail-inventory-md.js",
    "smoke:emails": "node scripts/smoke-all-emails.js",
    "smoke:messaging": "node scripts/smoke-messaging-e2e.js",
    "smoke:cron-emails": "node scripts/smoke-cron-emails.js",
    "test:resend": "node scripts/test-resend.js",
    "lint": "eslint . --max-warnings=204",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@azure-rest/ai-content-safety": "^1.0.1",
    "@azure/communication-identity": "^1.3.1",
    "@azure/communication-rooms": "^1.2.0",
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "^12.31.0",
    "@azure/storage-queue": "^12.29.0",
    "@langchain/core": "^1.1.44",
    "@langchain/google-genai": "^2.1.30",
    "@langchain/langgraph": "^1.3.0",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@prisma/client": "^6.19.2",
    "@sentry/node": "^10.73.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^21.3.4",
    "fluent-ffmpeg": "^2.1.3",
    "fs": "^0.0.1-security",
    "fs-extra": "^11.3.4",
    "geoip-lite": "^1.4.10",
    "handlebars": "^4.7.9",
    "i18next": "^25.10.10",
    "i18next-fs-backend": "^2.6.1",
    "i18next-http-middleware": "^3.9.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "path": "^0.12.7",
    "pg": "^8.13.1",
    "resend": "^6.12.4",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "stripe": "^22.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "xss": "^1.0.15",
    "zod": "^4.3.6"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.4.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.19.2",
    "supertest": "^7.2.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  }
}
