  driver_en_route_at          DateTime?            @db.Timestamp(6)
  picked_up_at                DateTime?            @db.Timestamp(6)
  delivery_proof              Json?
  delivery_proof_at           DateTime?            @db.Timestamp(6)
  delivery_preference         Json?
  delivery_delay_reason       Json?
  delivery_failure_resolution Json?
  delivery_proof_requirements Json?
  delivery_reschedule_request Json?
  driver_wait_compensation    Json?
  seller_handoff_checklist    Json?
  driver_earning              Float?
  grocery_substitutions       Json?
  substitution_preference     Json?
  delivery_offer_events       Json?
