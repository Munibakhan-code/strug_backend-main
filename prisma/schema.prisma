/// Creator's Choice — a channel recommends another creator's video or channel to subscribers.
model channel_creator_pick {
  pick_id           Int      @id @default(autoincrement())
  channel_id        Int
  pick_type         String   @db.VarChar(16)
  video_id          Int?
  target_channel_id Int?
