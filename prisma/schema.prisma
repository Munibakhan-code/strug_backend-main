/// "Notify me when this stream starts" opt-ins.
///
/// These lived only in a Redis set (`live:sched:notify:<id>`). Prod has no Redis, and the
/// client Proxy turns every command into a silent no-op, so the SADD wrote nothing, the
/// endpoint still answered `{ reminded: true }`, and the SMEMBERS read back an empty list —
/// every opt-in since launch was discarded and nobody was ever notified.
///
/// `notified_at` rather than deleting the row: it makes the fan-out idempotent (notify() is
/// not) and keeps the opt-in as a growth signal after the stream has been and gone.
model live_schedule_reminder {
  id          Int       @id @default(autoincrement())
  schedule_id Int
  user_id     Int
  created_at  DateTime  @default(now())
  notified_at DateTime?

  schedule live_stream_schedule @relation(fields: [schedule_id], references: [schedule_id], onDelete: Cascade)
  user     user                 @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([schedule_id, user_id])
  @@index([schedule_id, notified_at])
  @@index([user_id])
}

