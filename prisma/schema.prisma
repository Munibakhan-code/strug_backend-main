}

model calm_providers {
  calm_provider_id          Int            @id @default(autoincrement())
  provider_user_id          Int?
  calm_provider_category_id Int?
  calm_lesson               calm_lesson[]
  calm_category             calm_category? @relation(fields: [calm_provider_category_id], references: [calm_category_id], onDelete: NoAction, onUpdate: NoAction)
  user                      user?          @relation(fields: [provider_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model cam_post {
  cam_post_id    Int              @id @default(autoincrement())
  talent_id      Int?
  avg_duration   Int?
  description    String?
  price          Float?
  talent         talent?          @relation(fields: [talent_id], references: [talent_id], onDelete: NoAction, onUpdate: NoAction)
  cam_post_image cam_post_image[]
  cam_post_order cam_post_order[]
}

model cam_post_image {
  cam_post_image_id Int       @id @default(autoincrement())
  cam_post_id       Int?
  image_url         String?
  cam_post          cam_post? @relation(fields: [cam_post_id], references: [cam_post_id], onDelete: NoAction, onUpdate: NoAction)
}

model cam_post_order {
  cam_post_order_id Int        @id @default(autoincrement())
  cam_post_id       Int?
  user_id           Int?
  duration          Int?
  status            String?
  order_time        DateTime?  @db.Timestamp(6)
  delivered_time    DateTime?  @db.Timestamp(6)
  checkout_id       Int?
  cam_post          cam_post?  @relation(fields: [cam_post_id], references: [cam_post_id], onDelete: NoAction, onUpdate: NoAction)
  checkouts         checkouts? @relation(fields: [checkout_id], references: [checkout_id], onDelete: NoAction, onUpdate: NoAction)
  user              user?      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model candidate {
  candidate_id             Int                        @id @default(autoincrement())
  candidate_user_id        Int?
  headline                 String?
  bio                      String?
  skills                   String?
  resume_url               String?
  resume_json              Json?
  location                 String?
  desired_salary           Float?
  years_experience         Int?
  /// Opt-in: appear in employer passive talent-pool search (Phase 4).
  discoverable             Boolean                    @default(false)
  /// Paid boost: featured in talent pool until this timestamp.
  talent_boosted_until     DateTime?                  @db.Timestamp(6)
  user                     user?                      @relation(fields: [candidate_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  job_application          job_application[]
  candidate_portfolio_item candidate_portfolio_item[]
  candidate_resume         candidate_resume[]

  @@index([talent_boosted_until])
}

/// Named résumé versions for a seeker (Phase 4b multi-resume).
model candidate_resume {
  resume_version_id Int       @id @default(autoincrement())
  candidate_id      Int
  label             String    @db.VarChar(80)
  resume_json       Json?
  resume_url        String?
  is_default        Boolean   @default(false)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  candidate         candidate @relation(fields: [candidate_id], references: [candidate_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([candidate_id])
}

/// Seeker work samples / portfolio gallery (Jobs Phase 4).
model candidate_portfolio_item {
  portfolio_item_id Int       @id @default(autoincrement())
  candidate_id      Int
  title             String?
  url               String
  media_type        String?   @db.VarChar(20)
  sort_order        Int       @default(0)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  candidate         candidate @relation(fields: [candidate_id], references: [candidate_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([candidate_id])
}

model carpool_booking {
  booking_id    Int            @id @default(autoincrement())
  offer_id      Int?
  passenger_id  Int?
  seats_booked  Int?
  total_cost    Float?
  status        String?        @db.VarChar(20)
  carpool_offer carpool_offer? @relation(fields: [offer_id], references: [carpool_offer_id], onDelete: NoAction, onUpdate: NoAction)
  user          user?          @relation(fields: [passenger_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model carpool_offer {
  carpool_offer_id  Int                 @id @default(autoincrement())
  driver_id         Int?
  vehicle_id        Int?
  origin_city       String?             @db.VarChar(100)
  destination_city  String?             @db.VarChar(100)
  departure_time    DateTime?           @db.Timestamp(6)
  price_per_seat    Float?
  total_seats       Int?
  available_seats   Int?
  allow_smoking     Boolean?
  allow_pets        Boolean?
  carpool_booking   carpool_booking[]
  driver_profile    driver_profile?     @relation(fields: [driver_id], references: [driver_profile_id], onDelete: NoAction, onUpdate: NoAction)
  vehicle           vehicle?            @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: NoAction, onUpdate: NoAction)
  carpool_waypoints carpool_waypoints[]
}

model carpool_waypoints {
  waypoint_id      Int            @id @default(autoincrement())
  offer_id         Int?
  city_name        String?        @db.VarChar(100)
  arrival_time_est DateTime?      @db.Timestamp(6)
  pickup_allowed   Boolean?
  carpool_offer    carpool_offer? @relation(fields: [offer_id], references: [carpool_offer_id], onDelete: NoAction, onUpdate: NoAction)
}

model categories {
  category_id   Int         @id @default(autoincrement())
  category_name String?     @db.VarChar(1000)
  checkouts     checkouts[]
}

model chat_channel {
  channel_id           Int                    @id @default(autoincrement())
  type                 String?                @db.VarChar(20)
  channel_name         String?                @db.VarChar(255)
  platform_type_id     Int?
  context_type         String?                @db.VarChar(50)
  context_id           String?                @db.VarChar(255)
  created_by           Int?
  status               String?                @default("active") @db.VarChar(20)
  last_message_at      DateTime?              @db.Timestamp(6)
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @updatedAt @db.Timestamp(6)
  dm_key               String?                @unique(map: "uq_chat_channel_dm_key") @db.VarChar(255)
  platform_type        platform_type?         @relation(fields: [platform_type_id], references: [platform_type_id], onDelete: NoAction, onUpdate: NoAction)
  chat_messages        chat_messages[]
  chat_participants    chat_participants[]
  journal_bucket_item  journal_bucket_item[]
  journal_highlight    journal_highlight[]
  journal_time_capsule journal_time_capsule[]

  @@unique([context_type, context_id], map: "uq_chat_channel_context")
  @@index([context_type, context_id], map: "idx_chat_channel_context")
  @@index([last_message_at], map: "idx_chat_channel_last_message")
}

model chat_messages {
  message_id       Int            @id @default(autoincrement())
  channel_id       Int?
  sender_id        Int?
  content          String?
  content_type     String?        @db.VarChar(255)
  sent_at          DateTime?      @db.Timestamp(6)
  is_read          Boolean?
  platform_type_id Int?
  edited_at        DateTime?      @db.Timestamp(6)
  deleted_at       DateTime?      @db.Timestamp(6)
  metadata         Json?
  chat_channel     chat_channel?  @relation(fields: [channel_id], references: [channel_id], onDelete: NoAction, onUpdate: NoAction)
  platform_type    platform_type? @relation(fields: [platform_type_id], references: [platform_type_id], onDelete: NoAction, onUpdate: NoAction)
  user             user?          @relation(fields: [sender_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([channel_id, sent_at], map: "idx_chat_messages_channel_sent")
  @@index([sender_id, sent_at], map: "idx_chat_messages_sender_sent")
}

model chat_participants {
  chat_participant_id  Int            @id @default(autoincrement())
  channel_id           Int?
  user_id              Int?
  role                 String?        @db.VarChar(20)
  platform_type_id     Int?
  muted                Boolean        @default(false)
  last_read_message_id Int?
  joined_at            DateTime?      @default(now()) @db.Timestamp(6)
  left_at              DateTime?      @db.Timestamp(6)
  chat_channel         chat_channel?  @relation(fields: [channel_id], references: [channel_id], onDelete: NoAction, onUpdate: NoAction)
  platform_type        platform_type? @relation(fields: [platform_type_id], references: [platform_type_id], onDelete: NoAction, onUpdate: NoAction)
  user                 user?          @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([channel_id, user_id], map: "uq_chat_participants_channel_user")
  @@index([user_id, channel_id], map: "idx_chat_participants_user_channel")
}

model journal_highlight {
  id           Int           @id @default(autoincrement())
  channel_id   Int?
  saved_by     Int?
  message_id   Int?
  content      String?
  content_type String?       @db.VarChar(50)
  media_url    String?
  note         String?
  created_at   DateTime?     @default(now()) @db.Timestamp(6)
  chat_channel chat_channel? @relation(fields: [channel_id], references: [channel_id], onDelete: NoAction, onUpdate: NoAction)
  user         user?         @relation(fields: [saved_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([channel_id], map: "idx_journal_highlight_channel")
  @@index([saved_by], map: "idx_journal_highlight_saved_by")
}

model journal_bucket_item {
  id               Int           @id @default(autoincrement())
  channel_id       Int?
  created_by       Int?
  title            String?
  description      String?
  emoji            String?       @db.VarChar(10)
  category         String?       @db.VarChar(50)
  due_date         DateTime?     @db.Timestamp(6)
  priority         String?       @default("medium") @db.VarChar(10)
  is_completed     Boolean       @default(false)
  completed_at     DateTime?     @db.Timestamp(6)
  completed_by     Int?
  completion_note  String?
  completion_media String[]      @default([])
  created_at       DateTime?     @default(now()) @db.Timestamp(6)
  updated_at       DateTime?     @updatedAt @db.Timestamp(6)
  chat_channel     chat_channel? @relation(fields: [channel_id], references: [channel_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([channel_id], map: "idx_journal_bucket_channel")
}

model journal_time_capsule {
  id               Int           @id @default(autoincrement())
  channel_id       Int?
  created_by       Int?
  title            String?
  description      String?
  cover_url        String?
  unlock_date      DateTime      @db.Timestamp(6)
  is_unlocked      Boolean       @default(false)
  contents         Json?
  created_at       DateTime?     @default(now()) @db.Timestamp(6)
  partner_contents Json?
  partner_id       Int?
  chat_channel     chat_channel? @relation(fields: [channel_id], references: [channel_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([channel_id], map: "idx_journal_time_capsule_channel")
  @@index([unlock_date], map: "idx_journal_time_capsule_unlock")
  @@index([partner_id], map: "idx_journal_time_capsule_partner")
}

model checkouts {
  checkout_id     Int              @id @default(autoincrement())
  total           Decimal?         @db.Decimal
  share_id        Int?
  date            DateTime?        @db.Date
  category_id     Int?
  appointments    appointments[]
  cam_post_order  cam_post_order[]
  categories      categories?      @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  shared_ref_code shared_ref_code? @relation(fields: [share_id], references: [share_id], onDelete: NoAction, onUpdate: NoAction)
  courier_order   courier_order[]
  dg_order        dg_order[]
  product_order   product_order[]
  rental_order    rental_order[]
  service_order   service_order[]
}

model cloth {
  cloth_id          Int             @id @default(autoincrement())
  cloth_image_url   String?
  color             String?
  cloth_category_id Int?
  cloth_type_id     Int?
  user_id           Int?
