// Recruiter-initiated invites (consent-preserving). A recruiter invites a user by username;
// the invited user must Accept before a shared_ref_code link (and its revenue-share) is created.
// This gives recruiters the "add by username" UX without letting anyone skim a non-consenting
// user. One row per (recruiter, invited) pair; re-inviting a declined pair resets it to pending.
model recruit_invite {
  invite_id         Int       @id @default(autoincrement())
  recruiter_user_id Int
  invited_user_id   Int
  ref_code          String    @db.VarChar(1000)
  status            String    @default("pending") @db.VarChar(12) // pending | accepted | declined
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  responded_at      DateTime? @db.Timestamp(6)
  recruiter         user      @relation("recruit_invite_recruiter", fields: [recruiter_user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  invited           user      @relation("recruit_invite_invited", fields: [invited_user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([recruiter_user_id, invited_user_id])
  @@index([invited_user_id, status])
}

