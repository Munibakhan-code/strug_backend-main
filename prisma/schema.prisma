/// A driver's voluntarily-claimed run of same-vendor orders (v1: driver-initiated,
/// same-vendor-only stacking — see routes/food-routes.js claim-additional). Presence of a
/// batch_id on 2+ orders is what makes them "one run"; each order still moves through its own
/// independent accept/pickup/deliver lifecycle.
model delivery_batch {
  batch_id           Int                  @id @default(autoincrement())
  driver_profile_id  Int
  vertical           String               @db.VarChar(20) // 'food' | 'product'
  status             String               @default("active") @db.VarChar(30)
  order_count        Int                  @default(0)
  total_distance_km  Float?
  route_plan         Json?
  earnings_breakdown Json?
  eta_by_order       Json?
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @updatedAt @db.Timestamp(6)
  driver_profile     driver_profile       @relation(fields: [driver_profile_id], references: [driver_profile_id], onDelete: Cascade, onUpdate: NoAction)
  food_order         food_order[]
  product_order      product_order[]
  courier_order      courier_order[]
  delivery_run_offer delivery_run_offer[]
}

model delivery_run_offer {
  delivery_run_offer_id    Int            @id @default(autoincrement())
  batch_id                 Int
  order_type               String         @db.VarChar(40)
  order_id                 Int
  driver_profile_id        Int
  status                   String         @default("pending") @db.VarChar(24)
  incremental_distance_km  Float?
  incremental_duration_min Int?
  incremental_payout       Float?
  compatibility            Json?
  rejection_reason         String?        @db.VarChar(255)
  expires_at               DateTime?      @db.Timestamp(6)
  decided_at               DateTime?      @db.Timestamp(6)
  created_at               DateTime       @default(now()) @db.Timestamp(6)
  updated_at               DateTime?      @updatedAt @db.Timestamp(6)
  delivery_batch           delivery_batch @relation(fields: [batch_id], references: [batch_id], onDelete: Cascade, onUpdate: NoAction)
  driver_profile           driver_profile @relation(fields: [driver_profile_id], references: [driver_profile_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([batch_id, order_type, order_id], map: "uq_delivery_run_offer_order")
  @@index([driver_profile_id, status], map: "idx_delivery_run_offer_driver_status")
  @@index([batch_id, status], map: "idx_delivery_run_offer_batch_status")
}

/// Delivery-capable extension of driver_profile (food/product verticals). Presence of this
/// row is the capability marker — no enum column. Presence/location now come from
/// driver_profile (one online status per driver, gated by accepts_food/accepts_product) —
/// this row holds delivery-specific attributes such as vendor type, vehicle class, cold-bag,
/// heavy-item, and batching capacity.
model driver_delivery_profile {
  driver_profile_id      Int            @id
  vendor_type_id         Int?
  has_cold_bag           Boolean        @default(false)
  supports_heavy_items   Boolean        @default(false)
  max_heavy_item_kg      Float?
  max_batch_orders       Int            @default(2)
  max_batch_distance_km  Float?
  delivery_vehicle_class String?        @db.VarChar(30)
  driver_profile         driver_profile @relation(fields: [driver_profile_id], references: [driver_profile_id], onDelete: Cascade, onUpdate: NoAction)
  vendor_type            vendor_type?   @relation(fields: [vendor_type_id], references: [vendor_type_id], onDelete: NoAction, onUpdate: NoAction)
}

/// Courier-capable extension of driver_profile. No presence fields — courier has always read
/// driver_profile.is_online for online/offline state, so this carries that forward unchanged.
model driver_courier_profile {
  driver_profile_id Int            @id
  display_name      String?
  price_per_km      Float?
  driver_profile    driver_profile @relation(fields: [driver_profile_id], references: [driver_profile_id], onDelete: Cascade, onUpdate: NoAction)
}

