  booking_type     booking_type?  @relation(fields: [booking_type_id], references: [booking_type_id], onDelete: NoAction, onUpdate: NoAction)
}

model test_drive_request {
  test_drive_request_id Int             @id @default(autoincrement())
  vehicle_id            Int
  seller_id             Int
  buyer_id              Int
  preferred_date        DateTime        @db.Timestamp(6)
  preferred_time        String          @db.VarChar(50)
  full_name             String          @db.VarChar(255)
  phone_number          String          @db.VarChar(50)
  email                 String          @db.VarChar(255)
  notes                 String?         @db.Text
  status                TestDriveStatus @default(PENDING)
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  vehicle vehicle @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: Cascade)
  seller  user    @relation("TestDriveSeller", fields: [seller_id], references: [user_id], onDelete: Cascade)
  buyer   user    @relation("TestDriveBuyer", fields: [buyer_id], references: [user_id], onDelete: Cascade)
  // Partial UNIQUE index "test_drive_active_slot_key" on
  // (vehicle_id, preferred_date, preferred_time) WHERE status IN ('PENDING','CONFIRMED')
  // enforces one active booking per slot. Defined in raw SQL migration
  // 20260805094000_test_drive_unique_active_slot — Prisma cannot express partial indexes.

  @@index([vehicle_id])
  @@index([seller_id])
  @@index([buyer_id])
  @@index([status])
}

enum TestDriveStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

