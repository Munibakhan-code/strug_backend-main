  food_order_rating        food_order_rating[]
  food_vendor_closure      food_vendor_closure[]
  wallet                   food_vendor_wallet?
  payout_requests          food_vendor_payout_request[]
  user                     user?                        @relation(fields: [owner_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  vendor_type              vendor_type?                 @relation(fields: [vendor_type_id], references: [vendor_type_id], onDelete: NoAction, onUpdate: NoAction)
