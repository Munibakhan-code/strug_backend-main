}

model property_inquiry {
  inquiry_id    Int       @id @default(autoincrement())
  property_id   Int
  user_id       Int
  floor_plan_id Int?
  type          String?   @db.VarChar(40)
  name          String?   @db.VarChar(255)
  email         String?   @db.VarChar(255)
  phone         String?   @db.VarChar(40)
  message       String?
  status        String    @default("new") @db.VarChar(20)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @updatedAt @db.Timestamp(6)
  property      property  @relation(fields: [property_id], references: [property_id], onDelete: Cascade)
  user          user      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([property_id], map: "idx_property_inquiry_property")
  @@index([user_id], map: "idx_property_inquiry_user")
  @@index([status], map: "idx_property_inquiry_status")
}

model property_viewing {
  viewing_id   Int       @id @default(autoincrement())
  property_id  Int
  user_id      Int
  viewing_date DateTime? @db.Timestamp(6)
  note         String?
  status       String    @default("requested") @db.VarChar(20)
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @updatedAt @db.Timestamp(6)
  property     property  @relation(fields: [property_id], references: [property_id], onDelete: Cascade)
  user         user      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([property_id], map: "idx_property_viewing_property")
  @@index([user_id], map: "idx_property_viewing_user")
  @@index([status], map: "idx_property_viewing_status")
}

model property_save {
  save_id     Int      @id @default(autoincrement())
  property_id Int
  user_id     Int
  created_at  DateTime @default(now()) @db.Timestamp(6)
  property    property @relation(fields: [property_id], references: [property_id], onDelete: Cascade)
  user        user     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([property_id, user_id])
  @@index([user_id], map: "idx_property_save_user")
}

model property_follow {
  follow_id   Int      @id @default(autoincrement())
  property_id Int
  user_id     Int
  created_at  DateTime @default(now()) @db.Timestamp(6)
  property    property @relation(fields: [property_id], references: [property_id], onDelete: Cascade)
  user        user     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([property_id, user_id])
  @@index([user_id], map: "idx_property_follow_user")
}

model property_saved_search {
  saved_search_id  Int       @id @default(autoincrement())
  user_id          Int
  name             String?   @db.VarChar(120)
  vertical         String?   @db.VarChar(40)
  filters          Json
  alert_enabled    Boolean   @default(true)
  last_notified_at DateTime? @db.Timestamp(6)
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @updatedAt @db.Timestamp(6)
  user             user      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id], map: "idx_property_saved_search_user")
  @@index([alert_enabled], map: "idx_property_saved_search_alert")
}

model seller_capability {
  capability_id Int       @id @default(autoincrement())
  user_id       Int
  capability    String    @db.VarChar(40)
  // active | pending | rejected | suspended — realtor/precon start pending.
  status        String    @default("active") @db.VarChar(20)
  metadata      Json?
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @updatedAt @db.Timestamp(6)
  user          user      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, capability])
  @@index([capability], map: "idx_seller_capability_name")
  @@index([status], map: "idx_seller_capability_status")
}

/// User reports of fake / fraudulent property listings (real estate & precon).
model property_report {
  report_id   Int       @id @default(autoincrement())
  property_id Int
  reporter_id Int
  reason      String    @db.VarChar(80)
  details     String?
  status      String    @default("pending") @db.VarChar(20)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @updatedAt @db.Timestamp(6)
  property    property  @relation(fields: [property_id], references: [property_id], onDelete: Cascade)
  reporter    user      @relation(fields: [reporter_id], references: [user_id], onDelete: Cascade)

  @@index([status], map: "idx_property_report_status")
  @@index([property_id], map: "idx_property_report_property")
  @@index([reporter_id], map: "idx_property_report_reporter")
}

model hotel_room_type {
  room_type_id       Int                    @id @default(autoincrement())
  booking_listing_id Int
  name               String                 @db.VarChar(120)
  description        String?
  beds               String?                @db.VarChar(80)
  bed_count          Int?
  max_guests         Int                    @default(2)
  size_sqm           Float?
  quantity           Int                    @default(1)
  nightly_price      Float
  amenities          Json?
  images             Json?
  policies           String?
  sort_order         Int                    @default(0)
  is_active          Boolean                @default(true)
  created_at         DateTime               @default(now()) @db.Timestamp(6)
  updated_at         DateTime?              @updatedAt @db.Timestamp(6)
  booking_listing    booking_listing        @relation(fields: [booking_listing_id], references: [booking_listing_id], onDelete: Cascade)
  inventory          hotel_room_inventory[]
  bookings           booking[]

  @@index([booking_listing_id], map: "idx_hotel_room_type_listing")
}

model hotel_room_inventory {
  inventory_id   Int             @id @default(autoincrement())
  room_type_id   Int
  date           DateTime        @db.Date
  available      Int?
  price_override Float?
  is_blocked     Boolean         @default(false)
  room_type      hotel_room_type @relation(fields: [room_type_id], references: [room_type_id], onDelete: Cascade)

  @@unique([room_type_id, date])
  @@index([date], map: "idx_hotel_room_inventory_date")
}

model restaurant_seating {
  seating_id   Int                @id @default(autoincrement())
  vendor_id    Int
  name         String             @db.VarChar(80)
  description  String?
  capacity     Int?
  is_active    Boolean            @default(true)
  sort_order   Int                @default(0)
  food_vendor  food_vendor        @relation(fields: [vendor_id], references: [vendor_id], onDelete: Cascade)
  tables       restaurant_table[]
  reservations reservation[]

  @@index([vendor_id], map: "idx_restaurant_seating_vendor")
}

model restaurant_table {
  table_id     Int                 @id @default(autoincrement())
  vendor_id    Int
  seating_id   Int?
  name         String              @db.VarChar(40)
  min_seats    Int                 @default(1)
  max_seats    Int                 @default(4)
  is_active    Boolean             @default(true)
  food_vendor  food_vendor         @relation(fields: [vendor_id], references: [vendor_id], onDelete: Cascade)
  seating_area restaurant_seating? @relation(fields: [seating_id], references: [seating_id], onDelete: SetNull)
  reservations reservation[]

  @@index([vendor_id], map: "idx_restaurant_table_vendor")
  @@index([seating_id], map: "idx_restaurant_table_seating")
}

// =========================================
// Digital Service Schema
// =========================================

enum FreelancerStatus {
  APPROVED
  PENDING
  REJECTED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum GigStatus {
  ACTIVE
  PAUSED
  DRAFT
  DELETED
}

enum PackageType {
  BASIC
  STANDARD
  PREMIUM
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
}

enum WalletTransactionType {
  ORDER
  WITHDRAWAL
}

enum WalletTransactionStatus {
  PENDING
  AVAILABLE
  WITHDRAWN
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model BuyerProfile {
  id                          Int                          @id @default(autoincrement())
  user_id                     Int                          @unique
  user                        user                         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  orders                      FreelancerOrder[]
  reviews                     Review[]
  created_at                  DateTime                     @default(now())
  updated_at                  DateTime                     @updatedAt
  freelanceWalletTransactions FreelanceWalletTransaction[]

  @@index([user_id])
}

model FreelancerProfile {
  id                  Int                          @id @default(autoincrement())
  user_id             Int                          @unique
  display_name        String                       @db.VarChar(255)
  freelance_bio       String?
  tagline             String?                      @db.VarChar(255)
  country             String?                      @db.VarChar(100)
  city                String?                      @db.VarChar(100)
  languages           String[]
  skills              String[]
  status              FreelancerStatus             @default(APPROVED)
  user                user                         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  gigs                Gig[]
  orders              FreelancerOrder[]
  reviews             Review[]
  wallet              FreelancerWallet?
  wallet_transactions FreelanceWalletTransaction[]
  withdrawal_requests WithdrawalRequest[]
  created_at          DateTime                     @default(now())
  updated_at          DateTime                     @updatedAt

  @@index([user_id])
}

model Freelance_Category {
  id             Int                     @id @default(autoincrement())
  name           String                  @db.VarChar(150)
  slug           String                  @unique @db.VarChar(150)
  sub_categories Freelance_SubCategory[]
}

model Freelance_SubCategory {
  id          Int                @id @default(autoincrement())
  category_id Int
  name        String             @db.VarChar(150)
  slug        String             @unique @db.VarChar(150)
  category    Freelance_Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@index([category_id])
}

model Gig {
  id                    Int               @id @default(autoincrement())
  freelancer_profile_id Int
  freelancer_profile    FreelancerProfile @relation(fields: [freelancer_profile_id], references: [id], onDelete: Cascade)
  Freelance_Category    String            @db.VarChar(150)
  Freelance_SubCategory String            @db.VarChar(150)
  title                 String            @db.VarChar(255)
  description           String
  images                Json
  packages              Json
  status                GigStatus         @default(DRAFT)
  orders                FreelancerOrder[]
  reviews               Review[]
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  @@index([freelancer_profile_id])
  @@index([status])
  @@index([Freelance_SubCategory])
}

model FreelancerOrder {
  id                       Int                          @id @default(autoincrement())
  buyer_profile_id         Int
  freelancer_profile_id    Int
  gig_id                   Int
  buyer_profile            BuyerProfile                 @relation(fields: [buyer_profile_id], references: [id], onDelete: Cascade)
  freelancer_profile       FreelancerProfile            @relation(fields: [freelancer_profile_id], references: [id], onDelete: Cascade)
  gig                      Gig                          @relation(fields: [gig_id], references: [id], onDelete: Cascade)
  package_type             PackageType
  price                    Decimal                      @db.Decimal(12, 2)
  requirements             String?
  requirement_files        Json?
  status                   OrderStatus                  @default(PENDING)
  review                   Review?
  created_at               DateTime                     @default(now())
  completed_at             DateTime?
  stripe_payment_intent_id String?                      @unique
  payment_status           PaymentStatus                @default(PENDING)
  is_completed             Boolean                      @default(false)
  /// Per-order Referral friend code (this order only — not Recruit).
  referral_code            String?                      @db.VarChar(80)
  wallet_transactions      FreelanceWalletTransaction[]

  @@index([buyer_profile_id])
  @@index([freelancer_profile_id])
  @@index([gig_id])
  @@index([status])
}

model Review {
  id                    Int               @id @default(autoincrement())
  order_id              Int               @unique
  gig_id                Int
  buyer_profile_id      Int
  freelancer_profile_id Int
  freelancer_order      FreelancerOrder   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  gig                   Gig               @relation(fields: [gig_id], references: [id], onDelete: Cascade)
  buyer_profile         BuyerProfile      @relation(fields: [buyer_profile_id], references: [id], onDelete: Cascade)
  freelancer_profile    FreelancerProfile @relation(fields: [freelancer_profile_id], references: [id], onDelete: Cascade)
  rating                Int
  review                String?
  created_at            DateTime          @default(now())

  @@index([buyer_profile_id])
  @@index([freelancer_profile_id])
  @@index([order_id])
}

model FreelancerWallet {
  id                    Int                          @id @default(autoincrement())
  freelancer_profile_id Int                          @unique
  freelancer_profile    FreelancerProfile            @relation(fields: [freelancer_profile_id], references: [id], onDelete: Cascade)
  pending_balance       Decimal                      @default(0) @db.Decimal(12, 2)
  available_balance     Decimal                      @default(0) @db.Decimal(12, 2)
  total_earned          Decimal                      @default(0) @db.Decimal(12, 2)
  total_withdrawn       Decimal                      @default(0) @db.Decimal(12, 2)
  transactions          FreelanceWalletTransaction[]
  withdrawals           WithdrawalRequest[]
  created_at            DateTime                     @default(now())
  updated_at            DateTime                     @updatedAt

  @@index([freelancer_profile_id])
}

model FreelanceWalletTransaction {
  id                    Int                     @id @default(autoincrement())
  wallet_id             Int
  order_id              Int?
  buyer_profile_id      Int?
  freelancer_profile_id Int?
  wallet                FreelancerWallet?       @relation(fields: [wallet_id], references: [id], onDelete: Cascade)
  freelancer_order      FreelancerOrder?        @relation(fields: [order_id], references: [id], onDelete: SetNull)
  buyer_profile         BuyerProfile?           @relation(fields: [buyer_profile_id], references: [id], onDelete: SetNull)
  freelancer_profile    FreelancerProfile?      @relation(fields: [freelancer_profile_id], references: [id], onDelete: SetNull)
  amount                Decimal                 @db.Decimal(12, 2)
  type                  WalletTransactionType
  status                WalletTransactionStatus @default(PENDING)
  available_at          DateTime?
  created_at            DateTime                @default(now())

  @@index([wallet_id])
  @@index([order_id])
  @@index([buyer_profile_id])
  @@index([freelancer_profile_id])
  @@index([status])
  @@index([type])
}

model WithdrawalRequest {
  id                    Int               @id @default(autoincrement())
  freelancer_profile_id Int
  wallet_id             Int
  freelancer_profile    FreelancerProfile @relation(fields: [freelancer_profile_id], references: [id], onDelete: Cascade)
  wallet                FreelancerWallet  @relation(fields: [wallet_id], references: [id], onDelete: Cascade)
  amount                Decimal           @db.Decimal(12, 2)
  method                String            @db.VarChar(50)
  account_title         String            @db.VarChar(150)
  account_number        String            @db.VarChar(512)
  status                WithdrawalStatus  @default(PENDING)
  admin_note            String?
  requested_at          DateTime          @default(now())
  created_at            DateTime          @default(now())
  processed_at          DateTime?

  @@index([freelancer_profile_id])
  @@index([wallet_id])
  @@index([status])
}

// =========================================
// Book an Artist Schema
// =========================================

enum ArtistStatus {
  APPROVED
  PENDING
  REJECTED
  SUSPENDED
}

enum ArtistListingStatus {
  ACTIVE
  PAUSED
  DRAFT
  DELETED
}

enum ArtistBookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum ArtistPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum ArtistWalletTransactionType {
  BOOKING
  WITHDRAWAL
}

enum ArtistWalletTransactionStatus {
  PENDING
  AVAILABLE
  WITHDRAWN
}

enum ArtistWithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model ArtistBuyerProfile {
  id                  Int                       @id @default(autoincrement())
  user_id             Int                       @unique
  user                user                      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  bookings            ArtistBooking[]
  reviews             ArtistReview[]
  wallet_transactions ArtistWalletTransaction[]
  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt

  @@index([user_id])
}

model ArtistProfile {
  id                  Int                       @id @default(autoincrement())
  user_id             Int                       @unique
  display_name        String                    @db.VarChar(255)
  artist_bio          String?
  tagline             String?                   @db.VarChar(255)
  country             String?                   @db.VarChar(100)
  city                String?                   @db.VarChar(100)
  languages           String[]
  genres              String[]
  profile_image       String?
  cover_image         String?
  rating              Float                     @default(0)
  total_reviews       Int                       @default(0)
  total_bookings      Int                       @default(0)
  status              ArtistStatus              @default(PENDING)
  user                user                      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  listings            ArtistListing[]
  bookings            ArtistBooking[]
  reviews             ArtistReview[]
  wallet              ArtistWallet?
  wallet_transactions ArtistWalletTransaction[]
  withdrawal_requests ArtistWithdrawalRequest[]
  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt

  @@index([user_id])
  @@index([status])
}

model ArtistListing {
  id                Int                 @id @default(autoincrement())
  artist_profile_id Int
  artist_profile    ArtistProfile       @relation(fields: [artist_profile_id], references: [id], onDelete: Cascade)
  title             String              @db.VarChar(255)
  description       String
  category          String              @db.VarChar(100)
  genre             String              @db.VarChar(100)
  location          String?             @db.VarChar(255)
  instant_book      Boolean             @default(false)
  requires_deposit  Boolean             @default(false)
  deposit_amount    Decimal?            @db.Decimal(12, 2)
  cleaning_fee      Decimal?            @db.Decimal(12, 2)
  service_fee_pct   Decimal?            @db.Decimal(5, 2)
  images            Json
  status            ArtistListingStatus @default(DRAFT)
  packages          ArtistPackage[]
  bookings          ArtistBooking[]
  reviews           ArtistReview[]
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  @@index([artist_profile_id])
  @@index([status])
  @@index([category])
  @@index([genre])
}

model ArtistPackage {
  id                Int             @id @default(autoincrement())
  artist_listing_id Int
  artist_listing    ArtistListing   @relation(fields: [artist_listing_id], references: [id], onDelete: Cascade)
  title             String          @db.VarChar(255)
  description       String?
  duration_minutes  Int
  price             Decimal         @db.Decimal(12, 2)
  is_active         Boolean         @default(true)
  bookings          ArtistBooking[]
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  @@index([artist_listing_id])
}

model ArtistBooking {
  id                       Int                       @id @default(autoincrement())
  buyer_profile_id         Int
  artist_profile_id        Int
  artist_listing_id        Int
  package_id               Int
  buyer_profile            ArtistBuyerProfile        @relation(fields: [buyer_profile_id], references: [id], onDelete: Cascade)
  artist_profile           ArtistProfile             @relation(fields: [artist_profile_id], references: [id], onDelete: Cascade)
  artist_listing           ArtistListing             @relation(fields: [artist_listing_id], references: [id], onDelete: Cascade)
  package                  ArtistPackage             @relation(fields: [package_id], references: [id], onDelete: Cascade)
  event_name               String?                   @db.VarChar(255)
  event_date               DateTime
  event_time               String?                   @db.VarChar(50)
  expected_guests          Int?
  event_location           String
  notes                    String?
  referral_code            String?                   @db.VarChar(100)
  price                    Decimal                   @db.Decimal(12, 2)
  payment_status           ArtistPaymentStatus       @default(PENDING)
  status                   ArtistBookingStatus       @default(PENDING)
  stripe_payment_intent_id String?                   @unique
  review                   ArtistReview?
  wallet_transactions      ArtistWalletTransaction[]
  created_at               DateTime                  @default(now())
  completed_at             DateTime?

  @@index([buyer_profile_id])
  @@index([artist_profile_id])
  @@index([artist_listing_id])
  @@index([status])
}

model ArtistReview {
  id                Int                @id @default(autoincrement())
  booking_id        Int                @unique
  listing_id        Int
  buyer_profile_id  Int
  artist_profile_id Int
  booking           ArtistBooking      @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  listing           ArtistListing      @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  buyer_profile     ArtistBuyerProfile @relation(fields: [buyer_profile_id], references: [id], onDelete: Cascade)
  artist_profile    ArtistProfile      @relation(fields: [artist_profile_id], references: [id], onDelete: Cascade)
  rating            Int
  review            String?
  created_at        DateTime           @default(now())

  @@index([artist_profile_id])
  @@index([buyer_profile_id])
}

model ArtistWallet {
  id                Int                       @id @default(autoincrement())
  artist_profile_id Int                       @unique
  artist_profile    ArtistProfile             @relation(fields: [artist_profile_id], references: [id], onDelete: Cascade)
  pending_balance   Decimal                   @default(0) @db.Decimal(12, 2)
  available_balance Decimal                   @default(0) @db.Decimal(12, 2)
  total_earned      Decimal                   @default(0) @db.Decimal(12, 2)
  total_withdrawn   Decimal                   @default(0) @db.Decimal(12, 2)
  transactions      ArtistWalletTransaction[]
  withdrawals       ArtistWithdrawalRequest[]
  created_at        DateTime                  @default(now())
  updated_at        DateTime                  @updatedAt

  @@index([artist_profile_id])
}

model ArtistWalletTransaction {
  id                Int                           @id @default(autoincrement())
  wallet_id         Int
  booking_id        Int?
  buyer_profile_id  Int?
  artist_profile_id Int?
  wallet            ArtistWallet                  @relation(fields: [wallet_id], references: [id], onDelete: Cascade)
  booking           ArtistBooking?                @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  buyer_profile     ArtistBuyerProfile?           @relation(fields: [buyer_profile_id], references: [id], onDelete: SetNull)
  artist_profile    ArtistProfile?                @relation(fields: [artist_profile_id], references: [id], onDelete: SetNull)
  amount            Decimal                       @db.Decimal(12, 2)
  type              ArtistWalletTransactionType
  status            ArtistWalletTransactionStatus @default(PENDING)
  available_at      DateTime?
  created_at        DateTime                      @default(now())

  @@index([wallet_id])
  @@index([booking_id])
  @@index([status])
}

model ArtistWithdrawalRequest {
  id                Int                    @id @default(autoincrement())
  artist_profile_id Int
  wallet_id         Int
  artist_profile    ArtistProfile          @relation(fields: [artist_profile_id], references: [id], onDelete: Cascade)
  wallet            ArtistWallet           @relation(fields: [wallet_id], references: [id], onDelete: Cascade)
  amount            Decimal                @db.Decimal(12, 2)
  method            String                 @db.VarChar(50)
  account_title     String                 @db.VarChar(150)
  account_number    String                 @db.VarChar(512)
  status            ArtistWithdrawalStatus @default(PENDING)
  admin_note        String?
  requested_at      DateTime               @default(now())
  processed_at      DateTime?
  created_at        DateTime               @default(now())

  @@index([artist_profile_id])
  @@index([wallet_id])
  @@index([status])
}

// ── Event Concierge (personal event planner) ──────────────────────────────
model event_plan {
  event_plan_id          Int                   @id @default(autoincrement())
  owner_id               Int
  title                  String                @db.VarChar(200)
  occasion               String                @db.VarChar(40)
  event_date             DateTime?             @db.Timestamp(6)
  rsvp_deadline          DateTime?             @db.Timestamp(6)
  allow_late_rsvp        Boolean               @default(true)
  collaborators          Json? // array of user_id numbers with edit access
  guests                 Int?
  budget                 Decimal?              @db.Decimal(12, 2)
  city                   String?               @db.VarChar(100)
  vibe                   String?               @db.VarChar(40)
  notes                  String?
  invite_theme           String                @default("elegant") @db.VarChar(40)
  invite_message         String?
  cover_color            String?               @db.VarChar(20)
  share_token            String                @unique @db.VarChar(64)
  share_token_expires_at DateTime?             @db.Timestamp(6)
  status                 String                @default("planning") @db.VarChar(20)
  package_json           Json?
  created_at             DateTime              @default(now()) @db.Timestamp(6)
  updated_at             DateTime?             @updatedAt @db.Timestamp(6)
  owner                  user                  @relation("event_plan_owner", fields: [owner_id], references: [user_id], onDelete: Cascade)
  needs                  event_need[]
  guest_list             event_guest[]
  registry_items         event_registry_item[]

  @@index([owner_id], map: "idx_event_plan_owner")
  @@index([share_token], map: "idx_event_plan_share")
  @@index([status], map: "idx_event_plan_status")
}

model event_need {
  event_need_id        Int        @id @default(autoincrement())
  event_plan_id        Int
  category             String     @db.VarChar(40)
  title                String     @db.VarChar(200)
  status               String     @default("todo") @db.VarChar(20)
  target_budget        Decimal?   @db.Decimal(12, 2)
  notes                String?
  linked_nav           String?    @db.VarChar(40)
  linked_listing_id    Int?
  linked_listing_title String?    @db.VarChar(300)
  booking_id           Int?
  sort_order           Int        @default(0)
  created_at           DateTime   @default(now()) @db.Timestamp(6)
  event_plan           event_plan @relation(fields: [event_plan_id], references: [event_plan_id], onDelete: Cascade)

  @@index([event_plan_id], map: "idx_event_need_plan")
}

model event_guest {
  event_guest_id          Int        @id @default(autoincrement())
  event_plan_id           Int
  name                    String     @db.VarChar(200)
  email                   String?    @db.VarChar(200)
  phone                   String?    @db.VarChar(512)
  status                  String     @default("pending") @db.VarChar(20)
  plus_ones               Int        @default(0)
  rsvp_note               String?    @db.VarChar(500)
  invite_token            String     @unique @db.VarChar(64)
  invite_token_expires_at DateTime?  @db.Timestamp(6)
  invited_at              DateTime?  @db.Timestamp(6)
  responded_at            DateTime?  @db.Timestamp(6)
  created_at              DateTime   @default(now()) @db.Timestamp(6)
  event_plan              event_plan @relation(fields: [event_plan_id], references: [event_plan_id], onDelete: Cascade)

  @@index([event_plan_id], map: "idx_event_guest_plan")
  @@index([invite_token], map: "idx_event_guest_token")
  @@index([status], map: "idx_event_guest_status")
}

model event_registry_item {
  registry_item_id Int                           @id @default(autoincrement())
  event_plan_id    Int
  title            String                        @db.VarChar(500)
  description      String?
  image_url        String?
  price            Decimal                       @db.Decimal(12, 2)
  currency         String                        @default("CAD") @db.VarChar(3)
  item_type        String                        @default("custom") @db.VarChar(20)
  item_ref_id      Int?
  status           String                        @default("active") @db.VarChar(20)
  created_at       DateTime                      @default(now()) @db.Timestamp(6)
  updated_at       DateTime?                     @updatedAt @db.Timestamp(6)
  event_plan       event_plan                    @relation(fields: [event_plan_id], references: [event_plan_id], onDelete: Cascade)
  contributions    event_registry_contribution[]

  @@index([event_plan_id], map: "idx_event_registry_plan")
  @@index([status], map: "idx_event_registry_status")
}

model event_registry_contribution {
  contribution_id  Int                 @id @default(autoincrement())
  registry_item_id Int
  contributor_id   Int
  amount           Decimal             @db.Decimal(12, 2)
  payment_method   String              @default("wallet") @db.VarChar(20)
  status           String              @default("completed") @db.VarChar(20)
  note             String?             @db.VarChar(500)
  created_at       DateTime            @default(now()) @db.Timestamp(6)
  contributor      user                @relation("event_registry_contributor", fields: [contributor_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  registry_item    event_registry_item @relation(fields: [registry_item_id], references: [registry_item_id], onDelete: Cascade)

  @@index([registry_item_id], map: "idx_event_registry_contrib_item")
  @@index([contributor_id], map: "idx_event_registry_contrib_user")
}

// =========================================
// Celebrity (Cameo) Schema
// =========================================

enum CelebrityStatus {
  APPROVED
  PENDING
  REJECTED
  SUSPENDED
}

enum CelebrityListingStatus {
  ACTIVE
  PAUSED
  DRAFT
  DELETED
}

enum CelebrityBookingStatus {
  PENDING
  ACCEPTED
  RECORDING
  DELIVERED
  COMPLETED
  CANCELLED
}

enum CelebrityPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum CelebrityMessageType {
  MYSELF
  SOMEONE_ELSE
}

enum CelebrityWalletTransactionType {
  BOOKING
  WITHDRAWAL
}

enum CelebrityWalletTransactionStatus {
  PENDING
  AVAILABLE
  WITHDRAWN
}

enum CelebrityWithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model CelebrityBuyerProfile {
  id                  Int                          @id @default(autoincrement())
  user_id             Int                          @unique
  user                user                         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  bookings            CelebrityBooking[]
  reviews             CelebrityReview[]
  wallet_transactions CelebrityWalletTransaction[]
  created_at          DateTime                     @default(now())
  updated_at          DateTime                     @updatedAt

  @@index([user_id])
}

model CelebrityProfile {
  id                  Int                          @id @default(autoincrement())
  user_id             Int                          @unique
  display_name        String                       @db.VarChar(255)
  celebrity_bio       String?
  tagline             String?                      @db.VarChar(255)
  country             String?                      @db.VarChar(100)
  city                String?                      @db.VarChar(100)
  languages           String[]
  profile_image       String?
  cover_image         String?
  rating              Float                        @default(0)
  total_reviews       Int                          @default(0)
  total_bookings      Int                          @default(0)
  status              CelebrityStatus              @default(APPROVED)
  user                user                         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  listing             CelebrityListing?
  bookings            CelebrityBooking[]
  reviews             CelebrityReview[]
  wallet              CelebrityWallet?
  wallet_transactions CelebrityWalletTransaction[]
  withdrawal_requests CelebrityWithdrawalRequest[]
  created_at          DateTime                     @default(now())
  updated_at          DateTime                     @updatedAt

  @@index([user_id])
  @@index([status])
}

model CelebrityListing {
  id                   Int                    @id @default(autoincrement())
  celebrity_profile_id Int                    @unique
  celebrity_profile    CelebrityProfile       @relation(fields: [celebrity_profile_id], references: [id], onDelete: Cascade)
  title                String                 @db.VarChar(255)
  description          String
  category             String                 @db.VarChar(100)
  known_for            String                 @db.VarChar(255)
  location             String?                @db.VarChar(255)
  price_per_video      Decimal                @db.Decimal(12, 2)
  turnaround_days      Int
  // cleaning_fee          Decimal?                  @db.Decimal(12, 2)
  // service_fee_pct       Decimal?                  @db.Decimal(5, 2)
  // instant_book          Boolean                   @default(false)
  photos               Json
  status               CelebrityListingStatus @default(DRAFT)
  bookings             CelebrityBooking[]
  reviews              CelebrityReview[]
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt

  @@index([status])
  @@index([category])
}

model CelebrityBooking {
  id                       Int                          @id @default(autoincrement())
  buyer_profile_id         Int
  celebrity_profile_id     Int
  listing_id               Int
  buyer_profile            CelebrityBuyerProfile        @relation(fields: [buyer_profile_id], references: [id], onDelete: Cascade)
  celebrity_profile        CelebrityProfile             @relation(fields: [celebrity_profile_id], references: [id], onDelete: Cascade)
  listing                  CelebrityListing             @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  message_type             CelebrityMessageType
  recipient_name           String?                      @db.VarChar(255)
  request_message          String
  price                    Decimal                      @db.Decimal(12, 2)
  video_url                String?                      @db.VarChar(1000)
  payment_status           CelebrityPaymentStatus       @default(PENDING)
  status                   CelebrityBookingStatus       @default(PENDING)
  stripe_payment_intent_id String?                      @unique
  review                   CelebrityReview?
  /// Per-order Referral friend code (this booking only — not Recruit).
  referral_code            String?                      @db.VarChar(80)
  wallet_transactions      CelebrityWalletTransaction[]
  created_at               DateTime                     @default(now())
  completed_at             DateTime?

  @@index([buyer_profile_id])
  @@index([celebrity_profile_id])
  @@index([listing_id])
  @@index([status])
}

model CelebrityReview {
  id                   Int                   @id @default(autoincrement())
  booking_id           Int                   @unique
  listing_id           Int
  buyer_profile_id     Int
  celebrity_profile_id Int
  booking              CelebrityBooking      @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  listing              CelebrityListing      @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  buyer_profile        CelebrityBuyerProfile @relation(fields: [buyer_profile_id], references: [id], onDelete: Cascade)
  celebrity_profile    CelebrityProfile      @relation(fields: [celebrity_profile_id], references: [id], onDelete: Cascade)
  rating               Int
  review               String?
  created_at           DateTime              @default(now())

  @@index([buyer_profile_id])
  @@index([celebrity_profile_id])
}

model CelebrityWallet {
  id                   Int                          @id @default(autoincrement())
  celebrity_profile_id Int                          @unique
  celebrity_profile    CelebrityProfile             @relation(fields: [celebrity_profile_id], references: [id], onDelete: Cascade)
  pending_balance      Decimal                      @default(0) @db.Decimal(12, 2)
  available_balance    Decimal                      @default(0) @db.Decimal(12, 2)
  total_earned         Decimal                      @default(0) @db.Decimal(12, 2)
  total_withdrawn      Decimal                      @default(0) @db.Decimal(12, 2)
  transactions         CelebrityWalletTransaction[]
  withdrawals          CelebrityWithdrawalRequest[]
  created_at           DateTime                     @default(now())
  updated_at           DateTime                     @updatedAt

  @@index([celebrity_profile_id])
}

model CelebrityWalletTransaction {
  id                   Int                              @id @default(autoincrement())
  wallet_id            Int
  booking_id           Int?
  buyer_profile_id     Int?
  celebrity_profile_id Int?
  wallet               CelebrityWallet                  @relation(fields: [wallet_id], references: [id], onDelete: Cascade)
  booking              CelebrityBooking?                @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  buyer_profile        CelebrityBuyerProfile?           @relation(fields: [buyer_profile_id], references: [id], onDelete: SetNull)
  celebrity_profile    CelebrityProfile?                @relation(fields: [celebrity_profile_id], references: [id], onDelete: SetNull)
  amount               Decimal                          @db.Decimal(12, 2)
  type                 CelebrityWalletTransactionType
  status               CelebrityWalletTransactionStatus @default(PENDING)
  available_at         DateTime?
  created_at           DateTime                         @default(now())

  @@index([wallet_id])
  @@index([booking_id])
  @@index([status])
}

model CelebrityWithdrawalRequest {
  id                   Int                       @id @default(autoincrement())
  celebrity_profile_id Int
  wallet_id            Int
  celebrity_profile    CelebrityProfile          @relation(fields: [celebrity_profile_id], references: [id], onDelete: Cascade)
  wallet               CelebrityWallet           @relation(fields: [wallet_id], references: [id], onDelete: Cascade)
  amount               Decimal                   @db.Decimal(12, 2)
  method               String                    @db.VarChar(50)
  account_title        String                    @db.VarChar(150)
  account_number       String                    @db.VarChar(512)
  status               CelebrityWithdrawalStatus @default(PENDING)
  admin_note           String?
  requested_at         DateTime                  @default(now())
  processed_at         DateTime?
  created_at           DateTime                  @default(now())

  @@index([celebrity_profile_id])
  @@index([wallet_id])
  @@index([status])
}

/// Video searches, for the personalised chip row.
///
/// Deliberately separate from `social_search_history`, which belongs to the social module and is
/// keyed on social_profile — this one is video-only and keyed on user_id, so neither module
/// constrains the other.
///
/// `result_count` is the valuable column: a query that returned 0 rows is demand for content that
/// does not exist yet, and that never shows up in watch history because there was nothing to
/// watch. It is what tells you which creators to go and recruit.
model video_search_history {
  search_id    Int      @id @default(autoincrement())
  user_id      Int
  query        String   @db.VarChar(255)
  result_count Int?
  created_at   DateTime @default(now())
  user         user     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, created_at])
  // Powers the "searched for, found nothing" report.
  @@index([result_count, created_at])
}

// ============================================================================
// STRUG DEFENSE SHIELD: SECURITY TABLES
// ============================================================================

/// 1. Tracks IP and device history of users to detect VPN unmasking & ATO.
model user_ip_history {
  history_id  BigInt   @id @default(autoincrement())
  user_id     Int?
  ip_address  String   @db.VarChar(45)
  device_uuid String?  @db.VarChar(64)
  user_agent  String?  @db.Text
  asn         String?  @db.VarChar(64)
  isp         String?  @db.VarChar(128)
  country     String?  @db.VarChar(64)
  city        String?  @db.VarChar(64)
  is_vpn      Boolean  @default(false)
  created_at  DateTime @default(now())

  user user? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([user_id])
  @@index([ip_address])
  @@index([device_uuid])
}

/// 2. Forensic evidence locker for intercepted attacks and unmasked IPs.
model security_dossier {
  dossier_id      String   @id @db.VarChar(36)
  threat_score    Int      @default(95)
  threat_vector   String   @db.VarChar(64)
  client_ip       String   @db.VarChar(45)
  real_home_ip    String?  @db.VarChar(45)
  device_uuid     String?  @db.VarChar(64)
  target_endpoint String   @db.Text
  raw_payload     String?  @db.Text
  status          String   @default("LOCKED")
  created_at      DateTime @default(now())

  @@index([client_ip])
  @@index([device_uuid])
}

/// 3. Active quarantine ledger for jailed IPs and /24 subnets.
model active_quarantine {
  jail_id       String    @id @default(uuid()) @db.VarChar(36)
  target_entity String    @db.VarChar(64)
  target_type   String    @db.VarChar(20) // SINGLE_IP, SUBNET_24
  reason        String    @db.VarChar(128)
  jailed_at     DateTime  @default(now())
  expires_at    DateTime?
  is_permanent  Boolean   @default(false)
  is_active     Boolean   @default(true)

  @@index([target_entity])
  @@index([is_active])
}
