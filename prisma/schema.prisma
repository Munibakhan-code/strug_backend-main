// ===================================================
// NEW MODELS FOR INTERACTIVE POLLS & ANTI-FRAUD VOTING
// ===================================================

model town_hall_poll_option {
  option_id   Int                   @id @default(autoincrement())
  post_id     Int
  option_text String                @db.VarChar(100)
  post        town_hall_post        @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
  votes       town_hall_poll_vote[]

  @@index([post_id])
}

model town_hall_poll_vote {
  vote_id   Int                   @id @default(autoincrement())
  option_id Int
  user_id   Int
  /// Denormalized from the option so we can enforce one vote per user per poll at the DB layer.
  /// Unique(option_id, user_id) alone still allowed concurrent votes on two different options.
  post_id   Int
  option    town_hall_poll_option @relation(fields: [option_id], references: [option_id], onDelete: Cascade)
  user      user                  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  post      town_hall_post        @relation(fields: [post_id], references: [post_id], onDelete: Cascade)

  @@unique([option_id, user_id])
  @@unique([post_id, user_id])
  @@index([option_id])
  @@index([user_id])
  @@index([post_id])
}

