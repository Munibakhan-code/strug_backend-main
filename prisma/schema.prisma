// Unified cross-vertical notification (Epic 10). Generalises work_notification (same shape,
// keyed on user_id) into ONE table that every vertical writes through services/notify.js.
// The four legacy siloed tables (social/work/quote/board) stay for now; new verticals — rides,
// food, ecommerce, courier, bookings — land here from day one. See epics/10-GLOBAL-NOTIFICATIONS.md.
//
// Keyed on user_id, NOT social_profile.profile_id: a ride offer has no human sender and a
// driver may have no social_profile at all. `urgency` splits actionable (ride/work offers —
// claim card, countdown, sound) from ambient (order placed, payout — toast + bell).
model notification {
  notification_id Int       @id @default(autoincrement())
  user_id         Int
  vertical        String    @db.VarChar(24) // rideshare|food|ecommerce|courier|work|quotes|booking|social|video|live|townhall|payments|system
  type            String    @db.VarChar(40) // e.g. ride.offer, order.placed, payout.paid
  urgency         String    @default("ambient") @db.VarChar(12) // 'actionable' | 'ambient'
  title           String    @db.VarChar(180)
  body            String?
  entity_type     String?   @db.VarChar(32) // 'ride_request' | 'food_order' | ...
  entity_id       Int?
  action_url      String?   @db.VarChar(255) // deep-link target, e.g. sd-drive
  data            Json? // vertical-specific payload (fare, pickup, distance)
  is_read         Boolean   @default(false)
  expires_at      DateTime? @db.Timestamp(6) // actionable offers only; mirrors offer_expires_at
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  // group_actors/group_count/priority: applied live to strug-dev-db by a migration
  // (20260801084507_add_notification_priority_and_grouping) that is missing from this
  // checkout's prisma/migrations/ — reconciled here from the live DB schema so `db push`
  // doesn't try to drop populated columns. A proper migration file still needs writing once
  // that drift is resolved (flagged separately, not part of the driver-app work).
  group_actors    Json?
  group_count     Int       @default(1)
