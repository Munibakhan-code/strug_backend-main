  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  channel           channel  @relation("creator_pick_owner", fields: [channel_id], references: [channel_id], onDelete: Cascade)
  video             video?   @relation(fields: [video_id], references: [video_id], onDelete: Cascade)
  target_channel    channel? @relation("creator_pick_target", fields: [target_channel_id], references: [channel_id], onDelete: Cascade)
  // Partial UNIQUE indexes (raw SQL migration 20260825120000_channel_creator_pick) —
  // Prisma cannot express partial indexes:
  //   (channel_id, video_id) WHERE video_id IS NOT NULL
  //   (channel_id, target_channel_id) WHERE target_channel_id IS NOT NULL

