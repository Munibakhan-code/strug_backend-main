  voiceai_voice_presets                           voiceai_voice_preset[]
  security_admin                                  Boolean                             @default(false)
  user_ip_history                                 user_ip_history[]

  @@index([email], map: "idx_user_email")
  @@index([ref_code], map: "idx_user_ref_code")
  @@index([account_status])
  @@index([deleted_at])
  @@index([name])
