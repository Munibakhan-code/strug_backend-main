/// Per-vertical display identity. The shared social_profile remains the user's
/// "main" identity (Social, Town Hall, community, DMs). Each vertical that has an
/// "edit profile" (rideshare, food, ecommerce, work, services, hosting, etc.) gets
/// its own row here so edits in a seller dashboard never bleed into the main profile.
/// Until a user customizes a vertical (is_customized=false) reads inherit the main
/// profile's values. handle is its own separate identity per the product spec.
model vertical_profile {
  vertical_profile_id Int      @id @default(autoincrement())
  user_id             Int
  vertical            String   @db.VarChar(50)
  handle              String?  @unique @db.VarChar(50)
  display_name        String?  @db.VarChar(100)
  business_name       String?  @db.VarChar(150)
  bio                 String?
  profile_pic_url     String?
  banner_url          String?
  website             String?  @db.VarChar(300)
  location            String?  @db.VarChar(200)
  is_customized       Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  user                user     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, vertical])
  @@index([user_id])
  @@index([vertical])
  @@index([handle])
}

model social_profile {
  profile_id                 Int                     @id @default(autoincrement())
  user_id                    Int                     @unique
  handle                     String                  @unique @db.VarChar(50)
  /// #422: the post the OWNER chose to pin to their profile. A pointer on the profile rather
  /// than a flag on the post, because town_hall_post.is_pinned already drives the GLOBAL town
  /// hall feed sort — reusing it would shove a personal pin to the top of everyone's feed.
  /// pinned_post_type discriminates which table pinned_post_id refers to ('social' | 'townhall').
  pinned_post_id             Int?
  pinned_post_type           String?                 @db.VarChar(20)
  /// #436: LinkedIn-style opt-in status shown on the profile — 'available_for_work',
  /// 'open_to_opportunities' or 'hiring'. NULL (the default) means the user has not set one and
  /// the profile shows no badge at all. Kept as a validated VarChar rather than a Postgres enum
  /// so adding a status later is a code change, not a migration on a live table.
  work_status                String?                 @db.VarChar(32)
  display_name               String                  @db.VarChar(100)
  bio                        String?
  profile_pic_url            String?
  banner_url                 String?
  /// #481/#11: set true when the null-dead-profile-media maintenance script clears a
  /// profile_pic_url/banner_url whose Azure blob was purged (404). Drives a one-time
  /// "please re-upload your photo" notice; the FE clears it via /me/dismiss-avatar-notice.
  avatar_reset_notice        Boolean                 @default(false)
  is_verified                Boolean                 @default(false)
  is_private                 Boolean                 @default(false)
  is_shadow_banned           Boolean                 @default(false)
  is_banned                  Boolean                 @default(false)
  created_at                 DateTime                @default(now())
  updated_at                 DateTime                @updatedAt
  accepted_terms             Boolean                 @default(false)
  show_activity_status       Boolean                 @default(true)
  // #492: friend-video-activity discovery rail on the watch page. share_video_activity is a
  // PRIVACY opt-in — a friend's likes/watches only surface to their mutual-follows when they
  // turn it ON (default OFF; exposing watch history is sensitive). show_friend_video_activity
  // is the VIEWER-side toggle to hide the rail entirely (default ON). "Friends" = mutual follows.
  share_video_activity       Boolean                 @default(false)
  show_friend_video_activity Boolean                 @default(true)
  is_sensitive               Boolean                 @default(false)
  verification_type          VerificationType        @default(NONE)
  added_as_close_friend      close_friend[]          @relation("closeFriendTarget")
  close_friends              close_friend[]          @relation("closeFriendOwner")
  appeals_made               content_appeal[]
  following                  follower[]              @relation("follower")
  followers                  follower[]              @relation("following")
  audit_logs                 social_audit_log[]
  blocked_by                 social_block[]          @relation("blocked")
  blocked_users              social_block[]          @relation("blocker")
  bookmarks                  social_bookmark[]
  comments                   social_comments[]
  posts                      social_feed[]
  highlights                 social_highlight[]
  interactions               social_interactions[]
  muted_by                   social_mute[]           @relation("muted")
  muted_users                social_mute[]           @relation("muter")
  notifications_received     social_notification[]   @relation("notificationsReceived")
  notifications_sent         social_notification[]   @relation("notificationsSent")
  post_views                 social_post_view[]
  user                       user                    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  reports_sent               social_report[]         @relation("reports_sent")
  search_history             social_search_history[]
  social_stories             social_story[]
  story_views                story_view[]
  tags                       social_tag[]            @relation("social_profileTosocial_tag")

  @@index([user_id])
  @@index([handle])
  @@index([display_name])
}

model follower {
