generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model active_trip {
  trip_id                Int                 @id @default(autoincrement())
  request_id             Int?
  driver_id              Int?
  vehicle_id             Int?
  started_at             DateTime?           @db.Timestamp(6)
  ended_at               DateTime?           @db.Timestamp(6)
  actual_distance_km     Float?
  total_fare             Float?
  payment_method         String?             @db.VarChar(50)
  otp_code               String?             @db.VarChar(6)
  accepted_at            DateTime?           @default(now())
  driver_arrived_at      DateTime?           @db.Timestamp(6)
  driver_payout          Float?
  platform_fee           Float?
  tip_amount             Float?              @default(0)
  // No-login "share my trip" link (see routes/driver-safety-routes.js GET /track/:token),
  // mirroring courier_order.tracking_token. Nulled on trip completion; also carries a hard
  // TTL checked at read time in case /complete never fires.
  share_token            String?             @unique
  share_token_created_at DateTime?           @db.Timestamp(6)
  driver_profile         driver_profile?     @relation(fields: [driver_id], references: [driver_profile_id], onDelete: NoAction, onUpdate: NoAction)
  ride_request           ride_request?       @relation(fields: [request_id], references: [ride_request_id], onDelete: NoAction, onUpdate: NoAction)
  vehicle                vehicle?            @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: NoAction, onUpdate: NoAction)
  ride_rating            ride_rating?
  trip_sos_incident      trip_sos_incident[]
  trip_rider_rating      trip_rider_rating?

  @@index([driver_id], map: "idx_active_trip_driver")
}

// A driver's SOS press during a trip. Snapshots location + emergency-contact details at the
// moment of trigger so the record stays accurate even if the contact is later edited. No
// auto-dial to emergency services — the driver gets a tel: link client-side; this row is what
// alerts platform support. status moves open -> acknowledged -> resolved (no admin UI yet to
// drive that transition; this is the trigger + support-alert half only).
model trip_sos_incident {
  incident_id   Int         @id @default(autoincrement())
  trip_id       Int
  triggered_by  Int
  driver_lat    Float?
  driver_long   Float?
  contact_name  String?     @db.VarChar(120)
  contact_phone String?     @db.VarChar(512)
  status        String      @default("open") @db.VarChar(20)
  resolved_at   DateTime?
  resolved_by   Int?
  created_at    DateTime    @default(now())
  active_trip   active_trip @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)

  @@index([status, created_at], map: "idx_trip_sos_incident_status")
  @@index([trip_id], map: "idx_trip_sos_incident_trip")
}

// One row per driver_profile — edited from the driver's Account tab, referenced (snapshotted,
// not joined live) into trip_sos_incident when SOS is pressed.
model driver_emergency_contact {
  driver_profile_id Int            @id
  name              String         @db.VarChar(120)
  phone             String         @db.VarChar(512)
  relationship      String?        @db.VarChar(60)
  updated_at        DateTime       @default(now()) @updatedAt
  driver_profile    driver_profile @relation(fields: [driver_profile_id], references: [driver_profile_id], onDelete: Cascade)
}

// One row per (driver_profile_id, doc_type) — license/insurance/registration compliance
// documents, distinct from user.document_verification_* (that's a single-doc-per-user column
// set used for dating identity verification; a driver needs three independent documents each
// with its own status, which would collide if reused). Status vocabulary matches
// user.document_verification_status for codebase consistency.
model driver_document {
  document_id       Int             @id @default(autoincrement())
  driver_profile_id Int?
  doc_type          String          @db.VarChar(24) // 'license' | 'insurance' | 'registration'
  status            String          @default("unsubmitted") @db.VarChar(20) // unsubmitted | pending | verified | rejected
  document_url      String
  document_name     String?         @db.VarChar(255)
  expiry_date       DateTime?       @db.Date
  submitted_at      DateTime        @default(now())
  reviewed_at       DateTime?
  reviewed_by       Int?
  rejection_reason  String?
  // Soft-delete / archive (#1296). Profile delete sets deleted_at and nulls the FK (SET NULL)
  // so KYC artifacts survive for compliance instead of Cascade wipe.
  deleted_at        DateTime?
  driver_profile    driver_profile? @relation(fields: [driver_profile_id], references: [driver_profile_id], onDelete: SetNull, onUpdate: NoAction)

  // Active uniqueness is a partial index in SQL (driver_profile_id, doc_type WHERE deleted_at IS NULL).
  @@index([status])
  @@index([deleted_at])
}

model admin {
  aid      Int     @id @default(autoincrement())
  name     String? @db.VarChar(1000)
  email    String? @unique @db.VarChar(1000)
  password String? @db.VarChar(2000)
}

model agents {
  agent_id            Int     @id @default(autoincrement())
  agent_user_id       Int?
  company_name        String?
  company_web_url     String?
  company_country     String?
  role                String?
  company_logo_url    String?
  company_description String?
  company_size        String?
  industry            String?
  user                user?   @relation(fields: [agent_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  jobs                jobs[]
}

model appointment_rating {
  rating_id      Int           @id @default(autoincrement())
  user_id        Int?
  rating         Int?
  review         String?
  appointment_id Int?
  appointments   appointments? @relation(fields: [appointment_id], references: [appointment_id], onDelete: NoAction, onUpdate: NoAction)
  user           user?         @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model appointment_reviews {
  review_id      Int           @id @default(autoincrement())
  user_id        Int?
  review         String?
  appointment_id Int?
  appointments   appointments? @relation(fields: [appointment_id], references: [appointment_id], onDelete: NoAction, onUpdate: NoAction)
  user           user?         @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model appointment_service {
  service_id                   Int                           @id @default(autoincrement())
  service_name                 String?
  service_description          String?
  service_price                Float?
  service_image_url            String?
  service_category_id          Int?
  appointment_service_category appointment_service_category? @relation(fields: [service_category_id], references: [service_category_id], onDelete: NoAction, onUpdate: NoAction)
  appointments                 appointments[]
}

model appointment_service_category {
  service_category_id   Int                   @id @default(autoincrement())
  service_category_name String?
  appointment_service   appointment_service[]
}

model appointment_service_providers {
  service_provider_id      Int            @id @default(autoincrement())
  service_provider_user_id Int?
  company_phone_number     String?
  profile_picture          String?
  company_address          String?
  password                 String?
  language                 String?
  service_type             String?
  specialization           String?
  work_days_from           String?
  work_days_to             String?
  work_hours_from          DateTime?      @db.Time(6)
  work_hours_to            DateTime?      @db.Time(6)
  company_name             String?
  appointment_fee          Int?
  user                     user?          @relation(fields: [service_provider_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  appointments             appointments[]
}

model appointments {
  appointment_id                Int                            @id @default(autoincrement())
  service_provider_id           Int?
  user_id                       Int?
  time_to                       DateTime?                      @db.Timestamp(6)
  time_from                     DateTime?                      @db.Timestamp(6)
  date                          DateTime?                      @db.Date
  note                          String?
  service_id                    Int?
  checkout_id                   Int?
  status                        String?                        @default("pending")
  appointment_rating            appointment_rating[]
  appointment_reviews           appointment_reviews[]
  checkouts                     checkouts?                     @relation(fields: [checkout_id], references: [checkout_id], onDelete: NoAction, onUpdate: NoAction)
  appointment_service           appointment_service?           @relation(fields: [service_id], references: [service_id], onDelete: NoAction, onUpdate: NoAction)
  appointment_service_providers appointment_service_providers? @relation(fields: [service_provider_id], references: [service_provider_id], onDelete: NoAction, onUpdate: NoAction)
  user                          user?                          @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([service_provider_id], map: "idx_appointments_provider")
  @@index([user_id], map: "idx_appointments_user")
}

model bank_info {
  bank_info_id        Int        @id @default(autoincrement())
  employee_id         Int?
  account_holder      String?
  account_type        String?
  bank_name           String?
  bank_account_number String?
  bank_branch         String?
  employees           employees? @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction)
}

model behance {
  behance_id        Int                 @id @default(autoincrement())
  behance_user_id   Int?
  is_hireable       Boolean?
  user              user?               @relation(fields: [behance_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  behance_contacted behance_contacted[]
}

model behance_contacted {
  contacted_id   Int          @id @default(autoincrement())
  behance_id     Int?
  social_post_id Int?
  content        String?
  contacted_date DateTime?    @db.Timestamp(6)
  behance        behance?     @relation(fields: [behance_id], references: [behance_id], onDelete: NoAction, onUpdate: NoAction)
  social_feed    social_feed? @relation(fields: [social_post_id], references: [social_post_id], onDelete: NoAction, onUpdate: NoAction)
}

model booking_type {
  booking_type_id Int              @id @default(autoincrement())
  booking_type    String?          @db.VarChar(100)
  driver_profile  driver_profile[]
  vehicle         vehicle[]
  vehicle_types   vehicle_types[]
}

model calm_category {
  calm_category_id   Int              @id @default(autoincrement())
  calm_category_name String?
  calm_providers     calm_providers[]
}

model calm_lesson {
