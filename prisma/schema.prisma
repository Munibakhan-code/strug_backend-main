  lesson_price             Float?
  lesson_trailer_video_url String?
  calm_providers           calm_providers?         @relation(fields: [calm_provider_id], references: [calm_provider_id], onDelete: NoAction, onUpdate: NoAction)
  calm_lesson_image        calm_lesson_image[]
  calm_lesson_order_buy    calm_lesson_order_buy[]
  calm_lesson_parts        calm_lesson_parts[]
}

model calm_lesson_image {
  calm_lesson_image_id Int          @id @default(autoincrement())
  calm_lesson_id       Int?
  image_url            String?
  calm_lesson          calm_lesson? @relation(fields: [calm_lesson_id], references: [calm_lesson_id], onDelete: NoAction, onUpdate: NoAction)
}

model calm_lesson_order_buy {
  calm_lesson_order_buy_id Int          @id @default(autoincrement())
  calm_lesson_id           Int?
  user_id                  Int?
  order_time               DateTime?    @db.Timestamp(6)
  status                   String       @default("pending")
  calm_lesson              calm_lesson? @relation(fields: [calm_lesson_id], references: [calm_lesson_id], onDelete: NoAction, onUpdate: NoAction)
  user                     user?        @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
