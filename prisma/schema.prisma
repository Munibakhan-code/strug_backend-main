  signed_at         DateTime            @default(now())
  profile           ads_account_profile @relation(fields: [profile_id], references: [profile_id], onDelete: Cascade)
  user              user                @relation(fields: [signed_by_user_id], references: [user_id])
}

model ads_campaign {
  campaign_id           Int                    @id @default(autoincrement())
  ads_wallet_id         Int
  title                 String                 @db.VarChar(255)
  ad_type               String
  vertical              String
  media_url             String
  target_url            String?
  status                String                 @default("DRAFT")
  bid_type              String
  bid_amount            Decimal                @db.Decimal(12, 4)
  daily_budget          Decimal                @db.Decimal(12, 4)
  spent_today           Decimal                @default(0.00) @db.Decimal(12, 4)
  total_budget          Decimal                @db.Decimal(12, 4)
  total_spent           Decimal                @default(0.00) @db.Decimal(12, 4)
  target_countries      String[]
  target_cities         String[]
  target_interests      String[]
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  folder_tag            String?                @db.VarChar(100)
  objective             String                 @default("AWARENESS")
  dayparting_schedule   Json?
  frequency_cap         Int?                   @default(3)
  pacing_mode           String                 @default("STANDARD")
  placements            String[]
  aspect_ratio          String?                @default("1:1")
  cta_text              String?                @default("LEARN_MORE")
  description           String?                @db.VarChar(500)
  duration_sec          Int?                   @default(0)
  fallback_media_url    String?                @db.VarChar(500)
  file_size_bytes       BigInt?                @default(0)
  headline              String?                @db.VarChar(100)
  is_sensitive          Boolean?               @default(false)
  media_hash            String?                @db.VarChar(64)
  safety_score          Float?                 @default(1.0)
  main_category         String                 @default("SOCIAL")
  sub_category          String                 @default("strug_insta")
  ads_wallet            ads_wallet             @relation(fields: [ads_wallet_id], references: [ads_wallet_id])
  ads_targeting_profile ads_targeting_profile?
}

model ads_targeting_profile {
  targeting_id          Int          @id @default(autoincrement())
  campaign_id           Int          @unique
  min_age               Int?         @default(13)
  max_age               Int?         @default(65)
  genders               String[]
  languages             String[]
  device_platforms      String[]
  geofence_lat          Float?
  geofence_long         Float?
  geofence_radius_km    Float?
  lookalike_source_id   Int?
  excluded_profile_ids  Int[]
  connected_channel_ids Int[]
  campaign              ads_campaign @relation(fields: [campaign_id], references: [campaign_id], onDelete: Cascade)
}

/// Per-profile interest vector, recomputed periodically by the recommendation
/// cron from the user's engagement signals (likes/saves/shares/comments/views/
/// follows/watch-time). `interests` is a weighted token map, e.g.
/// { "#travel": 12.3, "food": 5.1 }. `top_tokens` is a denormalised slice of the
/// strongest tokens for fast candidate queries.
model user_interest_profile {
  id           Int      @id @default(autoincrement())
  profile_id   Int      @unique
  interests    Json     @default("{}")
  top_tokens   String[] @default([])
  top_creators Int[]    @default([])
  signal_count Int      @default(0)
  computed_at  DateTime @default(now())

  @@index([profile_id])
}

/// Unified impression + dwell-time capture for posts and videos. One row per
/// (profile, content) with cumulative dwell time and surface counts. Powers both
/// "avoid recommending the same content repeatedly" and dwell-weighted interest.
model content_impression {
  id           Int      @id @default(autoincrement())
  profile_id   Int
  content_type String   @db.VarChar(10)
  content_id   Int
  dwell_ms     Int      @default(0)
  impressions  Int      @default(1)
  completed    Boolean  @default(false)
  source       String?  @db.VarChar(20)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  @@unique([profile_id, content_type, content_id])
  @@index([profile_id])
  @@index([profile_id, content_type])
}

/// Durable per-viewer view dedup for videos. Counting one view per (video, viewer)
/// per ~10-minute window used to rely on a Redis lock, but prod has no managed Redis
/// (the client fails open), so every POST /view incremented views_count → inflated /
/// out-of-sync counts (#116/#169/#173). This table makes the dedup work without Redis.
/// identifier = "user:<id>" for signed-in viewers, "ip:<addr>" for anonymous ones.
model video_view {
  id         Int      @id @default(autoincrement())
  video_id   Int
  identifier String   @db.VarChar(80)
  viewed_at  DateTime @default(now())

  @@unique([video_id, identifier])
  @@index([video_id])
}

/// Single-use ad-view tokens. Each ad_token carries a unique `jti`; ad-view-complete
/// consumes it exactly once inside the payout transaction, so a replayed token aborts
/// (unique PK violation) and cannot double-credit a creator ("Ad Replay" fraud).
model used_ad_token {
  jti      String   @id
  video_id Int
  user_id  Int
  used_at  DateTime @default(now())

  @@index([used_at])
}

/// Rolling trending tokens (hashtags/keywords) computed over a recent window,
/// used to boost "trending within the user's areas of interest".
model trending_topic {
  id          Int      @id @default(autoincrement())
  token       String   @unique @db.VarChar(80)
  score       Float    @default(0)
  window_days Int      @default(3)
  computed_at DateTime @default(now())

  @@index([score])
}

model bug_report {
  bug_report_id  Int                     @id @default(autoincrement())
  user_id        Int?
  email          String?                 @db.VarChar(1000)
  title          String                  @db.VarChar(255)
  description    String
  category       String                  @default("bug") @db.VarChar(50)
  severity       String                  @default("medium") @db.VarChar(20)
  // 'open' | 'in_progress' | 'awaiting_reporter' | 'resolved' | 'wont_fix' | 'duplicate'.
  // awaiting_reporter means the board asked a question and is blocked on the reporter —
  // it exists so a blocked ticket doesn't sit in `open` looking like idle triage work.
  status         String                  @default("open") @db.VarChar(20)
  is_public      Boolean                 @default(false)
  page_url       String?                 @db.VarChar(1000)
  user_agent     String?                 @db.VarChar(1000)
  admin_note     String?
  // ── Auto-captured reporter context (2026-07-15) ────────────────────────────────
  // Most follow-up questions ("which account? which page? what threw?") are answerable
  // from what the client already knew at submit time. Capturing it kills the round-trip.
  // client_context is BOARD-ONLY: it can contain console text, so it is never returned by
  // /public or /mine. See sanitizeClientContext() in routes/bug-reports-routes.js — no
  // headers, tokens or request bodies are ever accepted into it.
  build_sha      String?                 @db.VarChar(40) // frontend commit that rendered the bug
  viewport       String?                 @db.VarChar(24) // "390x844"
  device_type    String?                 @db.VarChar(12) // mobile | tablet | desktop
  nav_id         String?                 @db.VarChar(64) // SPA page id ("social") — canonical vs page_url
  client_context Json? // { console: [...], api: [...], session: {...} }
  created_at     DateTime                @default(now())
  updated_at     DateTime                @default(now()) @updatedAt
  user           user?                   @relation(fields: [user_id], references: [user_id])
  screenshots    bug_report_screenshot[]
  messages       bug_report_message[]

  @@index([status], map: "idx_bug_report_status")
  @@index([is_public, status], map: "idx_bug_report_public")
  @@index([user_id], map: "idx_bug_report_user")
}

// Reporter ↔ board conversation on a ticket (2026-07-15).
//
// EVERY row here is visible to BOTH sides. There is deliberately no `is_internal` flag:
// `bug_report.admin_note` already IS the board-internal channel, so keeping the two in
// separate tables makes it structurally impossible to leak a triage note to the reporter
// by fumbling a boolean. If it's in this table, the reporter can read it.
//
// author_name is denormalised at write time (board member name, or the reporter's handle)
// so rendering a thread never needs a join — and a later rename doesn't rewrite history.
model bug_report_message {
  message_id       Int        @id @default(autoincrement())
  bug_report_id    Int
  author_type      String     @db.VarChar(12) // 'board' | 'reporter'
  author_member_id Int? // board_member.member_id when author_type='board'
  author_user_id   Int? // user.user_id when author_type='reporter'
  author_name      String?    @db.VarChar(120)
  body             String
  created_at       DateTime   @default(now())
  bug_report       bug_report @relation(fields: [bug_report_id], references: [bug_report_id], onDelete: Cascade, map: "bug_report_message_report_fkey")

  @@index([bug_report_id, created_at], map: "idx_bug_report_message_report")
}

model bug_report_screenshot {
  screenshot_id  Int        @id @default(autoincrement())
  bug_report_id  Int
  screenshot_url String     @db.VarChar(1000)
  sequence_order Int        @default(0)
  bug_report     bug_report @relation(fields: [bug_report_id], references: [bug_report_id], onDelete: Cascade, map: "bug_report_screenshot_report_fkey")

  @@index([bug_report_id], map: "idx_bug_report_screenshot_report")
}

model board_member {
  member_id             Int       @id @default(autoincrement())
  name                  String    @db.VarChar(255)
  email                 String    @unique @db.VarChar(255)
  password              String    @db.VarChar(2000)
  // Self-serve profile picture (2026-07-15): public Azure blob URL, or null → initials
  // fallback. Set via POST /board-auth/me/avatar; surfaced everywhere staff appear.
  avatar_url            String?   @db.VarChar(1000)
  status                String    @default("pending") @db.VarChar(20)
  can_assign            Boolean   @default(false)
  can_review            Boolean   @default(false)
  can_manage_members    Boolean   @default(false)
  approved_by           Int?
  approved_at           DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now()) @updatedAt
  can_view_users        Boolean   @default(false)
  can_access_restricted Boolean   @default(false)
  is_super_admin        Boolean   @default(false)
  // RBAC v2 (2026-07-13): a member holds one role (board_role) which defines their
  // dashboard access map + task/member caps. access_overrides is an optional per-member
  // delta on top of the role ({ dashboardId: "none"|"read"|"write" }) — this is how a
  // super-admin hand-tunes a single person ("Custom"). The legacy can_* booleans above
  // are DEPRECATED (kept for backfill/rollback; no longer the enforcement primitive)
  // except is_super_admin, which stays the hard, exclusive God-Mode/role-admin gate.
  role_id               Int?
  access_overrides      Json?

  @@index([status], map: "idx_board_member_status")
  @@index([role_id], map: "idx_board_member_role")
}

// RBAC v2 role. A role bundles a dashboard access map ({ dashboardId: "read"|"write" };
// absent = no access) plus coarse capabilities. Built-in roles are seeded and immutable
// in spirit (is_builtin=true); super-admins can also create named custom roles. Only the
// single built-in "Super Admin" role carries is_super_admin. Assigning/creating roles and
// editing access is a super-admin-only action; enforcement reads the resolved access map.
model board_role {
  role_id             Int      @id @default(autoincrement())
  key                 String   @unique @db.VarChar(60)
  name                String   @db.VarChar(120)
  description         String?  @db.VarChar(500)
  is_builtin          Boolean  @default(false)
  access              Json     @default("{}")
  manage_members      Boolean  @default(false)
  review_tasks        Boolean  @default(false)
  assign_tasks        Boolean  @default(false)
  is_super_admin      Boolean  @default(false)
  // Staff comms (2026-07-13): may this role create custom team / group channels?
  // (auto-provisioned team + company channels + DMs need no capability.)
  can_create_channels Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt

  @@index([is_builtin], map: "idx_board_role_builtin")
}

model board_task {
  task_id       Int       @id @default(autoincrement())
  title         String    @db.VarChar(255)
  description   String
  status        String    @default("backlog") @db.VarChar(30)
  assigner_id   Int
  assignee_id   Int?
  reviewer_id   Int?
  priority      String    @default("medium") @db.VarChar(20)
  vertical      String?   @db.VarChar(80)
  deadline      DateTime?
  doc_links     Json?
  review_notes  String?
  source_type   String?   @db.VarChar(30)
  source_id     Int?
  reopened_from Int?
  ready_at      DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt
  archived_at   DateTime?

  @@index([status], map: "idx_board_task_status")
  @@index([assignee_id], map: "idx_board_task_assignee")
  @@index([reviewer_id], map: "idx_board_task_reviewer")
}

model board_subtask {
  subtask_id Int     @id @default(autoincrement())
  task_id    Int
  label      String  @db.VarChar(255)
  is_done    Boolean @default(false)
  pr_link    String? @db.VarChar(500)
  position   Int     @default(0)

  @@index([task_id], map: "idx_board_subtask_task")
}

model board_pr_link {
  pr_link_id Int       @id @default(autoincrement())
  task_id    Int
  url        String    @db.VarChar(500)
  repo       String?   @db.VarChar(120)
  merged     Boolean   @default(false)
  merged_at  DateTime?

  @@index([task_id], map: "idx_board_pr_link_task")
}

model board_comment {
  comment_id Int      @id @default(autoincrement())
  task_id    Int
  author_id  Int
  body       String
  created_at DateTime @default(now())

  @@index([task_id], map: "idx_board_comment_task")
}

model board_notification {
  notification_id Int      @id @default(autoincrement())
  member_id       Int
  task_id         Int?
  // Staff comms (2026-07-13): nullable refs so the bell can carry channel_message /
  // mention / announcement notifications alongside the existing task-workflow ones.
  channel_id      Int?
  message_id      Int?
  type            String   @db.VarChar(40)
  body            String   @db.VarChar(500)
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now())

  @@index([member_id, is_read], map: "idx_board_notification_member")
}

model board_activity {
  activity_id Int      @id @default(autoincrement())
  task_id     Int
  actor_id    Int?
  action      String   @db.VarChar(120)
  created_at  DateTime @default(now())

  @@index([task_id], map: "idx_board_activity_task")
}

// ── PR review rounds (2026-08-09) ───────────────────────────────────────────
// Super-admin-only review board. The WORKFLOW deliberately reuses board_task:
// one task per PR with source_type='pr_review' and source_id=round_id, so the
// existing status flow (ready_for_review → approved | changes_requested),
// reviewer_id, review_notes, board_comment, board_activity audit and the GitHub
// webhook's board_pr_link → on_staging/done advance all work unchanged.
// These two tables add only what board_task has nowhere to put: the round-level
// write-up, and the per-PR review CONTENT (plain-English summary, expandable
// technical detail, before/after). Bare Int FKs match the board_* convention.
model pr_review_round {
  round_id     Int                @id @default(autoincrement())
  title        String             @db.VarChar(255)
  summary      String
  author_id    Int?
  reviewed_at  DateTime           @default(now()) @db.Timestamp(6)
  published_at DateTime?          @db.Timestamp(6)
  created_at   DateTime           @default(now()) @db.Timestamp(6)
  updated_at   DateTime           @default(now()) @updatedAt @db.Timestamp(6)
  details      pr_review_detail[]

  @@index([reviewed_at], map: "idx_pr_review_round_reviewed")
}

model pr_review_detail {
  detail_id        Int             @id @default(autoincrement())
  /// board_task.task_id — bare Int, matching the board_* convention (joins in the
  /// service layer). Unique so re-publishing a round upserts instead of duplicating.
  task_id          Int             @unique
  round_id         Int
  repo             String?         @db.VarChar(120)
  pr_number        Int?
  pr_author        String?         @db.VarChar(120)
  branch           String?         @db.VarChar(200)
  /// The reviewer's recommendation. Deliberately separate from board_task.status,
  /// which holds the super-admin's actual decision.
  verdict          String?         @db.VarChar(20)
  tldr             String?
  plain_summary    String
  technical_detail String?
  before_text      String?
  after_text       String?
  before_code      String?
  after_code       String?
  code_lang        String?         @db.VarChar(30)
  risk_note        String?
  risk_level       String?         @db.VarChar(10)
  created_at       DateTime        @default(now()) @db.Timestamp(6)
  updated_at       DateTime        @default(now()) @updatedAt @db.Timestamp(6)
  round            pr_review_round @relation(fields: [round_id], references: [round_id], onDelete: Cascade)

  @@index([round_id], map: "idx_pr_review_detail_round")
}

// ── Internal staff communication (2026-07-13) ───────────────────────────────
// Dedicated tables for board-member-to-board-member messaging, mirroring the
// proven user-facing chat_* design but keyed on board_member.member_id (NOT
// user.user_id — the two identity systems are disjoint). Bare Int FKs (no
// @relation) match the board_* convention; joins resolved in the service layer.
model staff_channel {
  channel_id      Int       @id @default(autoincrement())
  kind            String    @db.VarChar(20) // dm | team | company | topic | incident
  name            String?   @db.VarChar(120) // null for DMs
  dashboard_key   String?   @db.VarChar(60) // team channels: the board-rbac dashboard id they mirror
  is_private      Boolean   @default(false)
  allowed_roles   Json? // custom teams: board_role keys permitted to be invited
  created_by      Int // board_member.member_id
  dm_key          String?   @unique(map: "uq_staff_channel_dm_key") @db.VarChar(120) // "dm_<minId>_<maxId>" dedupe
  archived_at     DateTime?
  last_message_at DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now()) @updatedAt

  @@unique([kind, dashboard_key], map: "uq_staff_channel_team") // one auto channel per dashboard
  @@index([kind], map: "idx_staff_channel_kind")
  @@index([last_message_at], map: "idx_staff_channel_last_message")
}

model staff_channel_member {
  id                   Int       @id @default(autoincrement())
  channel_id           Int
  member_id            Int // board_member.member_id
  role                 String    @default("member") @db.VarChar(20) // owner | admin | member
  muted                Boolean   @default(false)
  last_read_message_id Int? // unread cursor
  joined_at            DateTime  @default(now())
  left_at              DateTime?

  @@unique([channel_id, member_id], map: "uq_staff_channel_member")
  @@index([member_id], map: "idx_staff_channel_member_member")
}

model staff_message {
  message_id   Int       @id @default(autoincrement())
  channel_id   Int
  sender_id    Int // board_member.member_id
  content      String
  content_type String    @default("text") @db.VarChar(20) // text | file | system | announcement
  parent_id    Int? // thread reply → staff_message.message_id
  pinned       Boolean   @default(false) // pinned to the channel (announcements auto-pin)
  metadata     Json? // mentions, attachments
  edited_at    DateTime?
  deleted_at   DateTime?
  created_at   DateTime  @default(now())

  @@index([channel_id, created_at], map: "idx_staff_message_channel_created")
  @@index([parent_id], map: "idx_staff_message_parent")
  @@index([channel_id, pinned], map: "idx_staff_message_pinned")
}

model store_profile {
  store_id        Int                   @id @default(autoincrement())
  user_id         Int                   @unique
  store_name      String?               @db.VarChar(255)
  address         String?               @db.VarChar(1000)
  lat             Float?
  lng             Float?
  prep_time       String?               @db.VarChar(255)
  profile_pic_url String?               @db.VarChar(1000)
  bio             String?               @db.VarChar(2000)
  cover_url       String?               @db.VarChar(1000)
  banner_url      String?               @db.VarChar(1000)
  is_active       Boolean               @default(true)
  is_open         Boolean               @default(true)
  user            user                  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  shipping_zones  store_shipping_zone[]
}

/// Seller-defined shipping zones for non-local ship-by-seller quotes.
model store_shipping_zone {
  zone_id    Int           @id @default(autoincrement())
  store_id   Int
  name       String        @db.VarChar(120)
  match_type String        @default("country") @db.VarChar(20) // country | city
  country    String        @db.VarChar(120)
  city       String?       @db.VarChar(120)
  fee        Float
  priority   Int           @default(100)
  is_active  Boolean       @default(true)
  created_at DateTime?     @default(now()) @db.Timestamp(6)
  store      store_profile @relation(fields: [store_id], references: [store_id], onDelete: Cascade)

  @@index([store_id], map: "idx_store_shipping_zone_store")
  @@index([store_id, country], map: "idx_store_shipping_zone_country")
}

model work_category {
  work_category_id Int               @id @default(autoincrement())
  parent_id        Int?
  name             String            @db.VarChar(120)
  slug             String            @unique @db.VarChar(140)
  icon_url         String?           @db.VarChar(1000)
  is_active        Boolean           @default(true)
  is_live          Boolean           @default(false)
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  parent           work_category?    @relation("work_category_parent", fields: [parent_id], references: [work_category_id], onDelete: NoAction, onUpdate: NoAction, map: "work_category_parent_fkey")
  children         work_category[]   @relation("work_category_parent")
  work_job         work_job[]
  worker_category  worker_category[]

  @@index([parent_id], map: "idx_work_category_parent")
}

model worker_profile {
  worker_profile_id Int                 @id @default(autoincrement())
  user_id           Int?                @unique
  bio               String?
  is_available      Boolean?            @default(false)
  current_lat       Float?
  current_long      Float?
  last_ping         DateTime?           @db.Timestamp(6)
  rating            Float?
  reliability_score Int                 @default(100)
  stripe_account_id String?             @db.VarChar(80)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  work_job_offer    work_job_offer[]
  work_review       work_review[]
  worker_category   worker_category[]
  reliability_audit reliability_audit[]
  user              user?               @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "worker_profile_user_fkey")
}

/// Append-only audit trail for every reliability score change.
/// Records what changed, why, and by how much — powers the worker-facing audit log
/// and the board's ability to investigate score disputes.
model reliability_audit {
  audit_id          Int            @id @default(autoincrement())
  worker_profile_id Int
  delta             Int
  score_before      Int
  score_after       Int
  reason            String         @db.VarChar(80)
  reference_type    String?        @db.VarChar(40)
  reference_id      Int?
  created_at        DateTime?      @default(now()) @db.Timestamp(6)
  worker_profile    worker_profile @relation(fields: [worker_profile_id], references: [worker_profile_id], onDelete: Cascade, onUpdate: NoAction, map: "reliability_audit_worker_fkey")

  @@index([worker_profile_id], map: "idx_reliability_audit_worker")
  @@index([created_at], map: "idx_reliability_audit_created")
}

model worker_category {
  worker_category_id Int              @id @default(autoincrement())
  worker_profile_id  Int
  work_category_id   Int
  /// Creator rate type for this leaf service: hourly | flat
  price_type         String?          @default("hourly") @db.VarChar(10)
  hourly_rate        Float?
  flat_rate          Float?
  work_category      work_category    @relation(fields: [work_category_id], references: [work_category_id], onDelete: Cascade, onUpdate: NoAction, map: "worker_category_category_fkey")
  worker_profile     worker_profile   @relation(fields: [worker_profile_id], references: [worker_profile_id], onDelete: Cascade, onUpdate: NoAction, map: "worker_category_worker_fkey")
  worker_package     worker_package[]

  @@unique([worker_profile_id, work_category_id], map: "uq_worker_category")
