model video {
  video_id            Int                    @id @default(autoincrement())
  channel_id          Int
  title               String                 @db.VarChar(255)
  description         String?
  file_size_bytes     BigInt?
  safety_score        Float?                 @default(0)
  is_monetizable      Boolean                @default(false)
  ad_revenue          Decimal                @default(0) @db.Decimal(12, 4)
  raw_video_url       String
  hls_url             String?
  thumbnail_url       String?
  duration_sec        Int                    @default(0)
  views_count         Int                    @default(0)
  video_type          String                 @default("long")
  status              String                 @default("pending")
  is_nsfw             Boolean                @default(false)
  digital_hash        String?                @unique
  youtube_id          String?                @unique @db.VarChar(32)
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt
  is_sensitive        Boolean                @default(false)
  processing_status   String                 @default("pending")
  processing_error    String?                @db.VarChar(500)
  processing_attempts Int                    @default(0)
  last_attempt_at     DateTime?
  // When a transcode task was last PUSHED to the queue — distinct from last_attempt_at, which is
  // when a worker last picked one UP. The reconciliation sweep exists to recover enqueues that were
  // LOST, and only this column can tell "no message was ever created" apart from "the message is
  // still waiting its turn in a deep lane". Stamped by enqueueVideoTask(); see utils/video-enqueue.js.
  last_enqueued_at    DateTime?
  public_id           String?                @unique @db.VarChar(16)
  slug                String?                @db.VarChar(80)
  category            String?                @default("General")
  moderation_flag     String?                @db.VarChar(40)
  thumbnail_is_custom Boolean                @default(false)
  safety_status       String                 @default("pending")
  playlist_items      playlist_item[]
  channel             channel                @relation(fields: [channel_id], references: [channel_id])
  video_analytics     video_analytics[]
  video_comments      video_comments[]
  video_likes         video_likes[]
  video_watch_later   video_watch_later[]
  watch_history       watch_history[]
  creator_picks       channel_creator_pick[]

  @@index([channel_id])
  @@index([status, created_at])
  @@index([status, views_count])
  @@index([video_type, status])
  @@index([processing_status, created_at])
  @@index([last_enqueued_at])
  @@index([moderation_flag])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

