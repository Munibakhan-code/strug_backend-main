  food_vendor                 food_vendor?         @relation(fields: [vendor_id], references: [vendor_id], onDelete: NoAction, onUpdate: NoAction)
  vendor_type                 vendor_type?         @relation(fields: [vendor_type_id], references: [vendor_type_id], onDelete: NoAction, onUpdate: NoAction)
  food_order_items            food_order_items[]
  food_order_rating           food_order_rating?
  delivery_batch              delivery_batch?      @relation(fields: [batch_id], references: [batch_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([user_id], map: "idx_food_order_user")
  @@index([order_flow, order_status], map: "idx_food_order_flow_status")
  @@index([vendor_id], map: "idx_food_order_vendor")
  @@index([payment_intent_id], map: "idx_food_order_intent")
  @@index([fulfillment_mode], map: "idx_food_order_fulfillment")
