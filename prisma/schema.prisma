  // include guest identity on GET /booking/bookings). Named relations because one user
  // can appear as guest on some rows and host on others.
  bookings_as_guest                               booking[]                           @relation("BookingGuest")
  bookings_as_host                                booking[]                           @relation("BookingHost")
  booking_reviews                                 booking_review[]
  // Test drive request relations
  test_drive_requests_as_seller                   test_drive_request[]                @relation("TestDriveSeller")
  test_drive_requests_as_buyer                    test_drive_request[]                @relation("TestDriveBuyer")
