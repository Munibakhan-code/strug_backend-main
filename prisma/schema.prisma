  vehicle_pic_url     String?
  booking_type_id     Int?
  price               Float?
  is_negotiable       Boolean              @default(false)
  mileage             Int?
  fuel                String?              @db.VarChar(50)
  transmission        String?              @db.VarChar(50)
  engine              String?              @db.VarChar(100)
  condition           String?              @db.VarChar(50)
  vehicle_type        String?              @db.VarChar(50)
