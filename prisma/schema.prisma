model town_hall_post {
  /// #415: video pipeline columns. Town hall posts used to play the ORIGINAL upload — the
  /// backend stored the raw file untouched (no transcode, no HLS, no poster, up to 50MB), so a
  /// feed video was slow to start and could not adapt bitrate. These mirror the `video` model so
  /// the SAME strug_worker pipeline can process a town hall post. Nullable with no default: an
  /// existing post keeps processing_status NULL, which the client reads as "no rendition, play
  /// media_url" — i.e. exactly today's behaviour, so nothing pre-existing looks stuck.
  hls_url             String?
  thumbnail_url       String?
  duration_sec        Int?
  processing_status   String?   @db.VarChar(20)
  processing_error    String?   @db.VarChar(500)
  processing_attempts Int       @default(0)
  last_attempt_at     DateTime?
  post_id             Int       @id @default(autoincrement())
  user_id             Int
  content             String    @db.VarChar(280)
  parent_id           Int?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  media_type          String?   @db.VarChar(50)
  media_url           String?
  quote_post_id       Int?
  scheduled_at        DateTime?
  view_count          Int       @default(0)

  // Production Upgrades
  is_pinned    Boolean @default(false)
  is_sensitive Boolean @default(false)
  is_banned    Boolean @default(false)
  product_id   Int? // Social Marketplace Product Pinning

  /// Dedup key for library import (e.g. X status id). Null for native Town Hall posts.
  external_source String? @db.VarChar(24)
  external_id     String? @db.VarChar(64)

  // Relations
  parent       town_hall_post?         @relation("replies", fields: [parent_id], references: [post_id])
  replies      town_hall_post[]        @relation("replies")
  quote_post   town_hall_post?         @relation("quotes", fields: [quote_post_id], references: [post_id], onUpdate: NoAction)
  quoted_by    town_hall_post[]        @relation("quotes")
  user         user                    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  likes        town_hall_post_like[]
  saves        town_hall_post_save[]
  views        town_hall_post_view[]
  reposts      town_hall_repost[]
  poll_options town_hall_poll_option[] // Live Poll Options
  poll_votes   town_hall_poll_vote[]
  product      product_listing?        @relation("town_hall_post_product", fields: [product_id], references: [listing_id], onDelete: SetNull)

  // Optimization Indexes
  @@unique([external_source, external_id])
  @@index([scheduled_at])
  @@index([user_id])
  @@index([parent_id])
  @@index([quote_post_id])
  @@index([parent_id, is_pinned, created_at])
}

