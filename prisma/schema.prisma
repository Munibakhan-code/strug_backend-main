model ride_rating {
  rating_id   Int         @id @default(autoincrement())
  trip_id     Int         @unique
  user_id     Int
  rating      Int
  review      String?
  created_at  DateTime    @default(now())
  active_trip active_trip @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)
  user        user        @relation(fields: [user_id], references: [user_id])
}

// Driver -> rider direction, the reverse of ride_rating (rider -> driver). Kept as a dedicated
// sibling table rather than extending ride_rating, whose trip_id is already @unique for the
// rider's rating — a second row for the same trip would collide with that constraint.
// Skippable in the UI (no persisted "pending rating" state needed) — a driver just never rates
// if they skip, no follow-up required.
model trip_rider_rating {
  rating_id   Int         @id @default(autoincrement())
  trip_id     Int         @unique
  rider_id    Int
  rating      Int
  review      String?
  created_at  DateTime    @default(now())
  active_trip active_trip @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)
  user        user        @relation(fields: [rider_id], references: [user_id])

  @@index([rider_id])
}

model email_verification {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  code       String
  created_at DateTime  @default(now())
  // #1294: schema-level expiry (app also checked created_at). used_at set when consumed;
  // rows are deleted on success, but used_at blocks races if delete lags.
  expires_at DateTime?
  used_at    DateTime?
}

/// Phase 2 Mail Health: recent send outcomes (PII-minimized recipient).
model mail_send_log {
  id                  Int      @id @default(autoincrement())
  created_at          DateTime @default(now())
  provider            String   @db.VarChar(32)
  to_hash             String   @db.VarChar(64)
  to_hint             String?  @db.VarChar(128)
  subject             String?  @db.VarChar(500)
  template            String?  @db.VarChar(100)
  status              String   @db.VarChar(32)
  provider_message_id String?  @db.VarChar(255)
  error               String?  @db.VarChar(1000)
  vertical            String?  @db.VarChar(64)
  tags                Json?

  @@index([created_at])
  @@index([status, created_at])
  @@index([template, created_at])
}

/// Phase 5: do-not-send list (bounce / complaint / manual).
model mail_suppression {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  to_hash    String   @unique @db.VarChar(64)
  to_hint    String?  @db.VarChar(128)
  reason     String   @db.VarChar(32)
  source     String?  @db.VarChar(64)
  active     Boolean  @default(true)
  note       String?  @db.VarChar(500)

  @@index([active, created_at])
}

/// Phase 5: durable outbox for critical transactional mail (OTP, receipts).
model mail_outbox {
  id             Int       @id @default(autoincrement())
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  status         String    @db.VarChar(32)
  attempts       Int       @default(0)
  next_attempt_at DateTime @default(now())
  to_hash        String    @db.VarChar(64)
  to_hint        String?   @db.VarChar(128)
  /// Encrypted recipient (encryptEmailForStorage).
  to_ciphertext  String    @db.VarChar(2000)
  subject        String    @db.VarChar(500)
  template       String?   @db.VarChar(100)
  vertical       String?   @db.VarChar(64)
  /// Rendered payload: { html, text?, tags?, headers? } — no large binary attachments.
  payload        Json
  last_error     String?   @db.VarChar(1000)
  provider_message_id String? @db.VarChar(255)
  sent_at        DateTime?

  @@index([status, next_attempt_at])
  @@index([to_hash, created_at])
  @@index([template, created_at])
}

