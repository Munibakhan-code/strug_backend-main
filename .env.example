# Copy to ".env" and fill in real values. Do not commit ".env".
# Get Gemini: https://aistudio.google.com/apikey

NODE_ENV=development
# APP_ENV=staging discriminates staging vs real production (both may use NODE_ENV=production)
# APP_ENV=
FRONTEND_URL=http://localhost:5173
# App host that serves /reset-password and /signup (prefer this over FRONTEND_URL for auth emails)
# APP_FRONTEND_URL=https://app.strug.ca
# Local HTTP only — never set false/0 in production (breaks Secure + SameSite=None cookies)
# COOKIE_SECURE=false

# --- REDIS (optional cache / auth rate limits) ---
# REDIS_URL=redis://127.0.0.1:6379
# Fail-closed auth rate limits when Redis is down. Auto-on when REDIS_URL is set on
# NODE_ENV=production and APP_ENV is not staging. Force with 1; disable with 0.
# AUTH_RATE_LIMIT_REQUIRE_REDIS=
# Public Swagger at /api-docs. Off on real production unless ENABLE_API_DOCS=1.
# ENABLE_API_DOCS=0

GOOGLE_API_KEY=
MODEL_NAME=gemini-flash-lite-latest

ACCESS_TOKEN_KEY=
REFRESH_TOKEN_KEY=

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME

# --- MAIL (transactional) ---
# Provider: resend (production default) | smtp (staging / cutover experiments)
MAIL_PROVIDER=resend
# From address (prefer verified Resend domain). Used by both providers.
RESEND_FROM_EMAIL=mail@strug.ca
# Resend API key — required when MAIL_PROVIDER=resend
RESEND_API_KEY=
# Fallback From local-part when RESEND_FROM_EMAIL unset. For generic SMTP relays,
# prefer SMTP_USER / SMTP_PASS. EMAIL_PASSWORD is deprecated (temporary fallback only).
EMAIL_USER=
# EMAIL_PASSWORD=   # deprecated — use SMTP_PASS
# Optional SMTP transport (defaults: smtp.resend.com:465 secure).
# Resend SMTP auth is username "resend" + RESEND_API_KEY as password (auto when host is *.resend.com).
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# Mail Health probe: comma-separated allowlisted inboxes for POST /admin/mail/probe
# MAIL_PROBE_ALLOWLIST=ops@strug.ca
# Phase 5 hardening (suppression / rate limits / critical outbox). Production cutover to SMTP is NOT enabled by these.
# MAIL_WEBHOOK_SECRET=  # required for POST /mail/webhook/events (bounce/complaint → suppression)
# MAIL_OUTBOX_DISABLED=false
# MAIL_OUTBOX_STALE_MS=120000
# MAIL_RATE_PER_RECIPIENT_HOUR=40
# MAIL_RATE_PER_RECIPIENT_HOUR_CRITICAL=20
# MAIL_RATE_PER_TEMPLATE_HOUR=2000
# Tech-support inbox: emailed when a customer posts in a support conversation (#468). Staff alert
# only — the customer is never emailed here (they get an in-app notification). Defaults to support@strug.ca.
SUPPORT_EMAIL=support@strug.ca
# Optional: public logo URL if assets/logo.png missing (inline CID fallback)
# STRUG_EMAIL_LOGO_URL=https://strug.ca/your-logo.png
# Opt-in branded saved-search emails (default off; in-app notify always runs)
# JOB_SAVED_SEARCH_EMAIL=true
# PROPERTY_SAVED_SEARCH_EMAIL=true
# Board invite login URL base (defaults to https://strug.ca/board)
# BOARD_URL=https://strug.ca

# --- VIDEO PIPELINE MONITOR (ops alerting) ---
# Where the video pipeline health monitor emails alerts when transcoding silently degrades
# (dead worker, wedged merge, stalled reconciliation sweep, growing un-transcoded backlog).
# Unset → alerts are logged to stderr only, never emailed. Comma-separate for multiple recipients.
VIDEO_ALERT_EMAIL=
# Cap INTERACTIVE Azure queue depth (video-tasks) before Videos upload routes return 429.
# Bulk/town-hall (video-tasks-bulk) is a separate lane and does not trip this gate.
# Protects the worker under mass-upload storms; raise when you add interactive worker replicas.
# VIDEO_QUEUE_BACKPRESSURE_DEPTH=500
# Brief in-process cache for that depth read (ms). 0 = always hit Azure. Default 2000.
# VIDEO_QUEUE_DEPTH_CACHE_MS=2000
# Per-user in-flight uploads (presign→finalize). Default 5. 100k users = many users × this, not one user × 100k.
# VIDEO_MAX_CONCURRENT_UPLOADS_PER_USER=5

# --- SYNTHETIC VIDEO PROBE (canary) ---
# Pushes a tiny bundled test clip through the real upload→transcode→HLS path on an interval and
# alerts (via the monitor above) if HLS doesn't come back — covers the blind spot where the other
# signals see nothing because no real video was uploaded. OFF unless explicitly enabled.
# Requires a dedicated throwaway CHANNEL id; the probe creates an 'unlisted' test video under it
# and deletes it (+ its blobs) after each run.
VIDEO_SYNTHETIC_PROBE_ENABLED=false
VIDEO_PROBE_CHANNEL_ID=
# Optional tuning (defaults shown):
# VIDEO_PROBE_INTERVAL_MIN=60
# VIDEO_PROBE_TIMEOUT_MIN=8

ACC_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

ENCRYPTION_KEY=

GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TIMEOUT_MS=2500

PLATFORM_FEE=0.08
FOOD_DELIVERY_FEE_PER_KM=2.5
FOOD_DELIVERY_BASE_FEE=0

# --- AZURE BLOB STORAGE (ststrugproduploads) ---
# Use ONE connection string only — do NOT set AccountKey / key1 / key2 separately.
# Azure Portal → Storage account → Security + networking → Access keys → Connection string (copy key1 OR key2 string).
AZURE_STORAGE_CONNECTION_STRING=

# Optional helpers (auto-derived from connection string if omitted)
AZURE_STORAGE_ACCOUNT_NAME=ststrugproduploads
AZURE_STORAGE_BLOB_ENDPOINT=https://ststrugproduploads.blob.core.windows.net/
AZURE_STORAGE_QUEUE_URL=https://ststrugproduploads.queue.core.windows.net/video-tasks

AZURE_RAW_VIDEO_CONTAINER=videos-raw
AZURE_PROCESSED_VIDEO_CONTAINER=videos-processed
AZURE_THUMBNAIL_CONTAINER=thumbnails
AZURE_LIVE_VOD_CONTAINER=live-vods

# --- AD ENGINE PRICING CONFIGURATION ---
AD_PRICE_VIDEO_VIEW=2.50
AD_PRICE_IMAGE_VIEW=0.75

AD_MULTIPLIER_FOOD=1.25
AD_MULTIPLIER_SOCIAL=1.10
AD_MULTIPLIER_VIDEO=1.00

AD_CREATOR_SHARE_RATIO=0.70

# --- FLOOR PLAN IMAGES (background removal) ---
# Provider for the automatic background-removal step on uploaded floor plan images.
# Supported: removebg | clipdrop | none. Unset/none → images are stored as-is
# (the original is ALWAYS kept as a fallback either way).
BG_REMOVAL_PROVIDER=none
BG_REMOVAL_API_KEY=
AZURE_FLOOR_PLANS_CONTAINER=floor-plans

AZURE_SOCIAL_POSTS_CONTAINER=social-posts
AZURE_SOCIAL_STORIES_CONTAINER=social-stories
AZURE_CHAT_MEDIA_CONTAINER=chat-media
AZURE_BUG_REPORTS_CONTAINER=bug-report-screenshots

# --- CHATTERBOX AI (VoiceAI text-to-speech) ---
# Our own self-hosted Chatterbox TTS service (open-source model, on Modal).
# Server-side only, never expose this URL to the browser. CHATTERBOX_INTERNAL_KEY
# is a shared secret sent as the X-Internal-Key header on every call to it.
CHATTERBOX_MODAL_BASE_URL=
CHATTERBOX_INTERNAL_KEY=
AZURE_VOICEAI_CONTAINER=voiceai-audio
# Past live stream recordings — uploaded after each broadcast ends (needs connection string above)
# LIVE_VOD_UPLOAD_TO_AZURE=true
# Shared key the strug.ca bug-report admin proxy sends as x-bug-admin-key. Set a strong value in prod.
BUG_ADMIN_KEY=Admin123!

# --- RIDESHARE DISPATCH ---
# Seconds before an unaccepted offer moves to the next driver (default 120)
RIDE_DRIVER_OFFER_TIMEOUT_SEC=120
# Driver must ping within this window while is_online=true (default 180s). Stale rows auto-expire offline.
RIDE_DRIVER_PRESENCE_STALE_SEC=180
# Min/max charge for rideshare Stripe & PayPal (CAD); amounts outside range return 400
RIDE_MIN_CHARGE_AMOUNT=0.5
RIDE_MAX_CHARGE_AMOUNT=500
# Set to true to notify all online drivers in range (local dev); production uses nearest-driver only
# RIDESHARE_BROADCAST_ALL=true

# --- DRIVER SAFETY (SOS) ---
# user_id of the support/safety inbox that receives an in-app alert when a driver presses SOS.
# UNSET IS NOT A SAFE DEFAULT: the incident row is still written, but no human is notified, and the
# driver's acknowledgement says so instead of "we've been alerted". Set this per environment.
# Open incidents are readable at GET /driver-safety/incidents (admin only).
SAFETY_ALERT_USER_ID=
# Public origin used to build the driver's no-login trip-share link (…/track-trip/<token>).
# Defaults to https://app.strug.ca, which is WRONG on staging — the token only exists in that
# environment's DB, so an unset value here hands out links that 404.
APP_PUBLIC_URL=

# --- AZURE CONTENT SAFETY (NSFW moderation) ---
# Create resource at: portal.azure.com > Content Safety
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# Revenue Share Configuration (70% to creators ONLY on Video/Streaming vertical)
AD_CREATOR_SHARE_RATIO=0.70                
AD_NON_CREATOR_SHARE_RATIO=0.00      

# Budget Thresholds (Adjustable values - Meta Ad Account inspired LKR Minimums)
AD_MIN_DAILY_BUDGET_LKR=300.00             
AD_MIN_LIFETIME_BUDGET_LKR=1500.00        
AD_MIN_WALLET_TOPUP_LKR=1500.00          

# Bidding Floor Prices (Floor price caps)
AD_CPM_FLOOR_PRICE_LKR=150.00             
AD_CPC_FLOOR_PRICE_LKR=15.00               
AD_CPV_FLOOR_PRICE_LKR=5.00              

# Anti-Fraud & Capping Controls
AD_ANTI_FRAUD_WINDOW_SEC=600               
AD_DEFAULT_FREQUENCY_CAP_DAILY=3           

# System Latency & Performance Guard
AD_ENGINE_MAX_LATENCY_MS=30                 
AD_PACING_BACKOFF_HOUR_THRESHOLD=0.85       
# ── Live channel subscriptions (Twitch-style paid subs, Stripe recurring) ──
# Monthly price in CAD dollars (default 4.99). Currency is CAD platform-wide.
SUB_PRICE_CAD=4.99
SUB_CURRENCY=CAD
# Fraction of each payment credited to the creator's wallet (rest = platform).
SUB_CREATOR_SHARE_RATIO=0.70
# Fraction of each live gift credited to the streamer wallet (rest = platform). Default 80%.
LIVE_GIFT_CREATOR_SHARE_RATIO=0.80
LIVE_COIN_CURRENCY=CAD
# Platform ledger user for gift/subscription platform share (default 1).
# Optional: pin an existing Stripe recurring Price id (otherwise auto-provisioned
# by lookup_key on first checkout).
# STRIPE_LIVE_SUB_PRICE_ID=price_xxx

# --- LIVE STREAMING (MediaMTX self-hosted RTMP -> HLS) ---
# Local: `npm run dev:docker:up` starts MediaMTX with Postgres/Redis (1935/8888/9996).
# LIVE_HOOK_SECRET must match the mediamtx compose env (default below).
# Local values — copy to .env (gitignored). Production uses deploy.yml / server secrets.
# LIVE_RTMP_URL=rtmp://127.0.0.1:1935
# LIVE_HLS_BASE=http://127.0.0.1:8888
# LIVE_WHIP_INTERNAL=http://127.0.0.1:8889
# LIVE_HOOK_SECRET=local-dev-live-hook-secret
# LIVE_VOD_PLAYBACK_BASE=http://127.0.0.1:9996
# LIVE_PUBLIC_PLAYBACK_BASE=http://localhost:5000/live-session/play
# LIVE_CDN_HLS_BASE=
# LIVE_VOD_AUTH_ENFORCE=true
# LIVE_GIFT_RATE_LIMIT_MS=1500
# Production example:
# LIVE_RTMP_URL=rtmp://live.strug.ca:1935
# LIVE_HLS_BASE=https://live.strug.ca/hls
# LIVE_HOOK_SECRET=<from secrets manager>
# LIVE_VOD_PLAYBACK_BASE=https://live.strug.ca/vod
# LIVE_VOD_AUTH_ENFORCE=true


STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""

STRIPE_FREELANCE_WEBHOOK_SECRET=""
# After a stream ends, VODs upload to Azure when AZURE_STORAGE_CONNECTION_STRING is set.
# LIVE_VOD_UPLOAD_TO_AZURE=false  # optional: skip Azure, keep VODs on media server only

# ── Web Push (VAPID) ────────────────────────────────────────────────────────────
# Background browser push (services/web-push-service.js, routes/push-routes.js,
# push_subscription table; SPA side is public/sw.js + Account settings).
#
# Deployed envs set these in deploy.yml --set-env-vars, NOT from this file:
#   prod    → secrets.VAPID_PRIVATE_KEY          (live since 2026-07-03)
#   staging → secrets.VAPID_PRIVATE_KEY_STAGING  (separate pair — a staging leak must not be
#                                                 able to push to prod users)
#
# Unset locally is fine: web-push-service.js:30 fails OPEN, so push silently no-ops and no
# notification code path breaks. Generate a local pair with: npx web-push generate-vapid-keys
#
# ⚠️ Browsers bind a push_subscription to the PUBLIC key. Changing it invalidates every existing
#    subscription — all subscribers must re-subscribe. Never rotate prod's pair casually.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@strug.ca

# --- Crash reporting (Sentry) --------------------------------------------------------------
#
# Leave unset and observability is fully inert: no init, no network calls, no behaviour change.
# That is the intended state for local dev and CI — set it only for staging/prod, where a route
# throwing on every call previously produced a generic 500 and no signal anywhere.
#
# Payloads are scrubbed before send (utils/observability.js): auth headers, cookies, passwords,
# tokens, OTPs and card fields are redacted, sendDefaultPii is off, and the user is identified
# by id only. Client-caused 4xx (validation/auth/not-found) are deliberately NOT reported.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
#
# Distinguishes environments in the Sentry UI. Falls back to APP_ENV, then NODE_ENV.
# SENTRY_ENVIRONMENT=
#
# Performance tracing is OFF by default (0). Tracing across ~2,100 endpoints is a separate cost
# decision — raise deliberately, e.g. 0.05 for 5% of requests.
# SENTRY_TRACES_SAMPLE_RATE=0

# --- Health probes -------------------------------------------------------------------------
#
# GET /health         liveness  — process only, no dependency I/O
# GET /health/ready   readiness — checks Postgres (hard) and Redis (soft); 503 when Postgres is down
# GET /health/startup startup   — same signal, separate path so probe budgets can differ
#
# Per-dependency timeout for the readiness checks, in ms. A probe that hangs is worse than one
# that fails: the orchestrator's own timeout fires and recycles a merely-slow replica.
# HEALTH_CHECK_TIMEOUT_MS=2000

# Grace period for draining in-flight requests on SIGTERM before the process force-exits.
# SHUTDOWN_TIMEOUT_MS=15000
