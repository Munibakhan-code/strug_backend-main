# Copy to .env in this folder. LIVE_HOOK_SECRET must match strug_backend-main/.env
# No ?secret= on auth URL — notify.sh sends x-live-hook-secret header only.

BACKEND_AUTH_URL=http://host.docker.internal:5000/live-session/rtmp/auth
BACKEND_HOOK_URL=http://host.docker.internal:5000/live-session/rtmp/event
LIVE_HOOK_SECRET=local-dev-live-hook-secret
