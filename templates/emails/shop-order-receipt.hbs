<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, Helvetica, sans-serif;">
    <tr>
        <td align="center" style="padding-bottom: 10px; background-color: #0b1120;">
            <span style="color: #e31e24; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 3px;">
                {{#if isVendor}}{{t 'emails.shop.receipt.vendor_tag'}}{{else}}{{t 'emails.shop.receipt.tag'}}{{/if}}
            </span>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 25px; background-color: #0b1120;">
            <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: 700;">
                {{#if isVendor}}{{t 'emails.shop.receipt.vendor_title'}}{{else}}{{t 'emails.shop.receipt.title'}}{{/if}}
            </h1>
            <p style="margin: 5px 0 0 0; color: #64748b; font-size: 14px;">{{t 'emails.shop.receipt.order_id'}} #{{order_id}}</p>
        </td>
    </tr>
    <tr>
        <td align="center" style="background-color: #0b1120;">
            <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" style="background-color: #000000; border-radius: 24px; border: 1px solid #1e293b;">
                <tr>
                    <td style="padding: 25px;">
                        <p style="margin: 0 0 8px 0; color: #64748b; font-size: 11px; text-transform: uppercase;">{{t 'emails.shop.receipt.product'}}</p>
                        <p style="margin: 0 0 16px 0; color: #ffffff; font-size: 16px; font-weight: bold;">{{product_name}}</p>
                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                            <tr>
                                <td style="color: #94a3b8; font-size: 13px;">{{t 'emails.shop.receipt.qty'}}</td>
                                <td align="right" style="color: #ffffff; font-size: 13px;">{{qty}}</td>
                            </tr>
                            <tr>
                                <td style="color: #ffffff; font-size: 16px; font-weight: bold; padding-top: 16px; border-top: 1px solid #1e293b;">{{t 'emails.shop.receipt.total'}}</td>
                                <td align="right" style="color: #e31e24; font-size: 20px; font-weight: 800; padding-top: 16px; border-top: 1px solid #1e293b;">{{currency}} {{total}}</td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-top: 35px; background-color: #0b1120;">
            <p style="margin: 0; font-size: 14px; color: #94a3b8; line-height: 1.6;">
                {{#if isVendor}}{{t 'emails.shop.receipt.vendor_msg'}}{{else}}{{t 'emails.shop.receipt.thanks'}}{{/if}}
            </p>
        </td>
    </tr>
</table>
