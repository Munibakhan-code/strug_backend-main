<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, Helvetica, sans-serif;">
    <tr>
        <td align="center" style="padding-bottom: 12px; background-color: #0b1120;">
            <span style="color: #e31e24; font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 3px;">{{t 'emails.otp.tag'}}</span>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 15px; background-color: #0b1120;">
            <h1 style="margin: 0; color: #ffffff !important; font-size: 32px; font-weight: bold;">{{t 'emails.otp.title'}}</h1>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 35px; background-color: #0b1120;">
            <p style="margin: 0; color: #94a3b8; font-size: 16px; line-height: 1.6;">{{t 'emails.otp.instruction'}}</p>
        </td>
    </tr>
    <tr>
        <td align="center" style="background-color: #0b1120;">
            <table border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" style="background-color: #000000; border-radius: 20px; border: 1px solid #1e293b;">
                <tr>
                    <td align="center" style="padding: 25px 45px; background-color: #000000; border-radius: 20px; color: #ffffff !important; font-size: 48px; font-weight: bold; letter-spacing: 12px;">
                        {{otp_code}}
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-top: 35px; background-color: #0b1120;">
            <p style="margin: 0; font-size: 13px; color: #475569;">{{t 'emails.otp.ignore'}}</p>
        </td>
    </tr>
</table>
