<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, sans-serif;">
    <tr>
        <td align="center" style="padding-bottom: 10px; background-color: #0b1120;">
            <font color="#e31e24" style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 3px;">{{t 'emails.carpool_booking.tag'}}</font>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 25px; background-color: #0b1120;">
            <h1 style="margin: 0; color: #ffffff; font-size: 32px; font-weight: bold;">{{t 'emails.carpool_booking.title'}}</h1>
        </td>
    </tr>

    <!-- Booking Detail Island -->
    <tr>
        <td align="center" style="background-color: #0b1120;">
            <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" style="background-color: #000000; border-radius: 24px; border: 1px solid #1e293b;">
                <tr>
                    <td style="padding: 25px;">
                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                            <tr>
                                <td style="color: #94a3b8; font-size: 13px;">{{t 'emails.carpool_booking.seats'}}</td>
                                <td align="right" style="color: #ffffff; font-size: 16px; font-weight: bold;">{{seats_booked}}</td>
                            </tr>
                            <tr>
                                <td style="color: #94a3b8; font-size: 13px; padding-top: 10px;">{{t 'emails.carpool_booking.total_cost'}}</td>
                                <td align="right" style="color: #ffffff; font-size: 16px; font-weight: bold;"> {{currency}} {{total_cost}}</td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>

    <!-- Route Island -->
    <tr>
        <td align="left" style="padding: 30px 0 0 0; background-color: #0b1120;">
            <table width="100%" border="0" cellspacing="0" cellpadding="0">
                <tr>
                    <td style="padding-bottom: 15px;">
                        <p style="margin: 0; color: #64748b; font-size: 11px; text-transform: uppercase;">{{t 'emails.carpool_booking.from'}}</p>
                        <p style="margin: 5px 0 0 0; color: #ffffff; font-size: 15px; font-weight: bold;">{{origin_city}}</p>
                    </td>
                </tr>
                <tr>
                    <td>
                        <p style="margin: 0; color: #64748b; font-size: 11px; text-transform: uppercase;">{{t 'emails.carpool_booking.to'}}</p>
                        <p style="margin: 5px 0 0 0; color: #ffffff; font-size: 15px; font-weight: bold;">{{destination_city}}</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>

    <tr>
        <td align="center" style="padding-top: 35px; background-color: #0b1120;">
            <p style="margin: 0; font-size: 14px; color: #94a3b8;">{{t 'emails.carpool_booking.details_msg'}}</p>
            <p style="margin: 15px 0 0 0; font-size: 14px; color: #e31e24; font-weight: bold;">{{t 'emails.carpool_booking.thanks'}}</p>
        </td>
    </tr>
</table>
