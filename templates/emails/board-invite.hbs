<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, sans-serif;">
    <tr>
        <td align="center" style="padding-bottom: 12px; background-color: #0b1120;">
            <font color="#e31e24" style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 3px;">{{t 'emails.board_invite.tag'}}</font>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 15px; background-color: #0b1120;">
            <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: bold;">{{t 'emails.board_invite.title'}}</h1>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 25px; background-color: #0b1120;">
            <p style="margin: 0; color: #94a3b8; font-size: 16px; line-height: 1.6;">{{t 'emails.board_invite.instruction' name=name}}</p>
        </td>
    </tr>

    <tr>
        <td align="center" style="background-color: #0b1120;">
            <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" style="background-color: #000000; border-radius: 24px; border: 1px solid #1e293b;">
                <tr>
                    <td style="padding: 25px;">
                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                            <tr>
                                <td style="color: #64748b; font-size: 13px; padding-bottom: 5px;">{{t 'emails.board_invite.email_label'}}</td>
                                <td align="right" style="color: #ffffff; font-size: 14px; font-weight: bold;">{{email}}</td>
                            </tr>
                            <tr>
                                <td style="color: #64748b; font-size: 13px; padding-top: 10px;">{{t 'emails.board_invite.temp_password'}}</td>
                                <td align="right" style="color: #ffffff; font-size: 14px; font-weight: bold; font-family: monospace;">{{temp_password}}</td>
                            </tr>
                            {{#if role_label}}
                            <tr>
                                <td style="color: #64748b; font-size: 13px; padding-top: 10px;">{{t 'emails.board_invite.role'}}</td>
                                <td align="right" style="color: #ffffff; font-size: 14px; font-weight: bold;">{{role_label}}</td>
                            </tr>
                            {{/if}}
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>

    <tr>
        <td align="center" style="padding-top: 35px; background-color: #0b1120;">
            <table border="0" cellspacing="0" cellpadding="0">
                <tr>
                    <td align="center" bgcolor="#e31e24" style="border-radius: 100px;">
                        <a href="{{board_url}}" target="_blank" style="padding: 12px 30px; color: #ffffff; font-size: 13px; font-weight: bold; text-decoration: none; display: inline-block;">
                            {{t 'emails.board_invite.button'}}
                        </a>
                    </td>
                </tr>
            </table>
            <p style="margin: 25px 0 0 0; font-size: 13px; color: #475569; line-height: 1.5;">{{t 'emails.board_invite.change_password'}}</p>
        </td>
    </tr>
</table>
