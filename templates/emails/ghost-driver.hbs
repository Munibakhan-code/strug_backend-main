<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, sans-serif;">
    <tr>
        <td align="center" style="padding-bottom: 12px; background-color: #0b1120;">
            <font color="#e31e24" style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 3px;">{{t 'emails.ghost_driver.tag'}}</font>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 20px; background-color: #0b1120;">
            <h1 style="margin: 0; color: #ffffff; font-size: 30px; font-weight: bold;">{{t 'emails.ghost_driver.title'}}</h1>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 30px; background-color: #0b1120;">
            <p style="margin: 0; color: #94a3b8; font-size: 16px; line-height: 1.6;">
                {{t 'emails.ghost_driver.instruction'}}
            </p>
        </td>
    </tr>

    <!-- Status Island -->
    <tr>
        <td align="center" style="background-color: #0b1120;">
            <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" style="background-color: #000000; border-radius: 20px; border: 1px solid #e31e24;">
                <tr>
                    <td align="center" style="padding: 20px;">
                        <p style="margin: 0; color: #ffffff; font-size: 14px; font-weight: bold;">
                            {{t 'emails.ghost_driver.status'}}
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>

    <tr>
        <td align="center" style="padding-top: 35px; background-color: #0b1120;">
            <p style="margin: 0; font-size: 14px; color: #94a3b8;">{{t 'emails.ghost_driver.hang_tight'}}</p>
        </td>
    </tr>
</table>