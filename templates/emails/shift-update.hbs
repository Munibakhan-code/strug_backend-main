<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, sans-serif;">
    <tr>
        <td align="center" style="padding-bottom: 12px; background-color: #0b1120;">
            <font color="#e31e24" style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 3px;">{{t 'emails.shift_update.tag'}}</font>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 25px; background-color: #0b1120;">
            <h1 style="margin: 0; color: #ffffff; font-size: 30px; font-weight: bold;">{{t 'emails.shift_update.title'}}</h1>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 30px; background-color: #0b1120;">
            <p style="margin: 0; color: #94a3b8; font-size: 16px; line-height: 1.6;">
                {{t 'emails.shift_update.instruction'}}
            </p>
        </td>
    </tr>

    <!-- Shift Details Island -->
    <tr>
        <td align="center" style="background-color: #0b1120;">
            <table border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" style="background-color: #000000; border-radius: 20px; border: 1px solid #1e293b;">
                <tr>
                    <td style="padding: 25px; min-width: 280px;">
                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                            <tr>
                                <td style="color: #64748b; font-size: 12px; text-transform: uppercase; padding-bottom: 5px;">{{t 'emails.shift_update.start_time'}}</td>
                                <td align="right" style="color: #ffffff; font-size: 15px; font-weight: bold;">{{from_time}}</td>
                            </tr>
                            <tr><td colspan="2" style="padding-top: 10px; border-bottom: 1px solid #1e293b;"></td></tr>
                            <tr>
                                <td style="color: #64748b; font-size: 12px; text-transform: uppercase; padding-top: 15px;">{{t 'emails.shift_update.end_time'}}</td>
                                <td align="right" style="color: #ffffff; font-size: 15px; font-weight: bold; padding-top: 15px;">{{to_time}}</td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>

    <tr>
        <td align="center" style="padding-top: 35px; background-color: #0b1120;">
            <p style="margin: 0; font-size: 13px; color: #475569; line-height: 1.5;">{{t 'emails.shift_update.thanks'}}</p>
        </td>
    </tr>
</table>