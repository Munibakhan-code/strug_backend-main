<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, sans-serif;">
    <tr>
        <td align="center" style="padding-bottom: 12px; background-color: #0b1120;">
            <font color="#e31e24" style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 3px;">{{t 'emails.ads.spend_alert.tag'}}</font>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 15px; background-color: #0b1120;">
            <h1 style="margin: 0; color: #ffffff; font-size: 32px; font-weight: bold;">{{t 'emails.ads.spend_alert.title'}}</h1>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 25px; background-color: #0b1120;">
            <p style="margin: 0; color: #94a3b8; font-size: 16px; line-height: 1.6;">{{t 'emails.ads.spend_alert.instruction'}}</p>
            <p style="margin: 20px 0 0 0; color: #ffffff; font-size: 20px; font-weight: bold;">
                {{t 'emails.ads.spend_alert.campaign_label'}} #{{campaign_id}}
            </p>
        </td>
    </tr>
    <tr>
        <td align="center" style="background-color: #0b1120;">
            <table border="0" cellspacing="0" cellpadding="0">
                <tr>
                    <td align="center" bgcolor="#e31e24" style="border-radius: 100px;">
                        <a href="{{frontend_url}}/dashboard" target="_blank" style="padding: 15px 35px; color: #ffffff; font-size: 14px; font-weight: bold; text-decoration: none; display: inline-block;">
                            {{t 'emails.ads.spend_alert.button'}}
                        </a>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-top: 35px; background-color: #0b1120;">
            <p style="margin: 0; font-size: 13px; color: #475569;">{{t 'emails.common.need_help'}}</p>
        </td>
    </tr>
</table>
