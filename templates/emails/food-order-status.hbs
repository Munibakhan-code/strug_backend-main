<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, sans-serif;">
    <tr>
        <td align="center" style="padding-bottom: 12px; background-color: #0b1120;">
            <font color="#e31e24" style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 3px;">{{t 'emails.food_status.tag'}}</font>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 15px; background-color: #0b1120;">
            <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: bold;">{{status_title}}</h1>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 30px; background-color: #0b1120;">
            <p style="margin: 0; color: #94a3b8; font-size: 16px; line-height: 1.6;">{{status_message}}</p>
        </td>
    </tr>

    <!-- Status Island -->
    <tr>
        <td align="center" style="background-color: #0b1120;">
            <table border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" style="background-color: #000000; border-radius: 20px; border: 1px solid #1e293b;">
                <tr>
                    <td align="center" style="padding: 20px 40px;">
                        <p style="margin: 0; color: #64748b; font-size: 11px; text-transform: uppercase;">{{t 'emails.food_status.labels.order_id'}}</p>
                        <p style="margin: 5px 0 0 0; color: #ffffff; font-size: 18px; font-weight: bold;">#{{order_id}}</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>

    <tr>
        <td align="center" style="padding-top: 40px; background-color: #0b1120;">
            <table border="0" cellspacing="0" cellpadding="0">
                <tr>
                    <td align="center" bgcolor="#e31e24" style="border-radius: 100px;">
                        <a href="http://localhost:3000/orders/{{order_id}}" target="_blank" style="padding: 12px 30px; color: #ffffff; font-size: 13px; font-weight: bold; text-decoration: none; display: inline-block;">
                            Track Order
                        </a>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>