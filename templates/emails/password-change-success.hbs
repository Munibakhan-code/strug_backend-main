<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, sans-serif;">
    <tr>
        <td align="center" style="padding-bottom: 12px; background-color: #0b1120;">
            <font color="#e31e24" style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 3px;">{{t 'emails.password_changed.tag'}}</font>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 15px; background-color: #0b1120;">
            <h1 style="margin: 0; color: #ffffff; font-size: 30px; font-weight: bold;">{{t 'emails.password_changed.title'}}</h1>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 30px; background-color: #0b1120;">
            <p style="margin: 0; color: #94a3b8; font-size: 16px; line-height: 1.6;">
                {{t 'emails.password_changed.instruction'}}
            </p>
        </td>
    </tr>

    <!-- Security Warning Box -->
    <tr>
        <td align="center" style="background-color: #0b1120;">
            <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" style="background-color: #000000; border-radius: 20px; border: 1px solid #ff4d4d;">
                <tr>
                    <td align="center" style="padding: 20px;">
                        <p style="margin: 0; color: #ff4d4d; font-size: 13px; font-weight: bold;">
                            {{t 'emails.password_changed.warning'}}
                        </p>
                        <table border="0" cellspacing="0" cellpadding="0" style="margin-top: 15px;">
                            <tr>
                                <td align="center" bgcolor="#e31e24" style="border-radius: 100px;">
                                    <a href="{{frontend_url}}/support" target="_blank" style="padding: 10px 25px; color: #ffffff; font-size: 12px; font-weight: bold; text-decoration: none; display: inline-block;">
                                        {{t 'emails.password_changed.button'}}
                                    </a>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>

    <tr>
        <td align="center" style="padding-top: 35px; background-color: #0b1120;">
            <p style="margin: 0; font-size: 13px; color: #475569;">
                {{t 'emails.password_changed.footer'}}
            </p>
        </td>
    </tr>
</table>