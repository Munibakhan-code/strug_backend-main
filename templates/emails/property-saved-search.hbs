<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, sans-serif;">
    <tr>
        <td align="center" style="padding-bottom: 12px; background-color: #0b1120;">
            <font color="#e31e24" style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 3px;">{{t 'emails.property_saved_search.tag'}}</font>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 15px; background-color: #0b1120;">
            <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: bold;">{{headline}}</h1>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 25px; background-color: #0b1120;">
            <p style="margin: 0; color: #94a3b8; font-size: 16px; line-height: 1.6;">{{t 'emails.property_saved_search.greeting' name=name}}</p>
            <p style="margin: 12px 0 0 0; color: #94a3b8; font-size: 15px; line-height: 1.5;">{{summary}}</p>
        </td>
    </tr>

    <tr>
        <td align="center" style="background-color: #0b1120;">
            <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" style="background-color: #000000; border-radius: 24px; border: 1px solid #1e293b;">
                <tr>
                    <td style="padding: 25px;">
                        {{#each matches}}
                        <p style="margin: 0 0 4px 0; color: #ffffff; font-size: 14px; font-weight: bold;">{{title}}</p>
                        {{#if detail}}
                        <p style="margin: 0 0 14px 0; color: #64748b; font-size: 13px;">{{detail}}</p>
                        {{else}}
                        <p style="margin: 0 0 14px 0;">&nbsp;</p>
                        {{/if}}
                        {{/each}}
                    </td>
                </tr>
            </table>
        </td>
    </tr>

    <tr>
        <td align="center" style="padding-top: 35px; background-color: #0b1120;">
            <table border="0" cellspacing="0" cellpadding="0">
                <tr>
                    <td align="center" bgcolor="#e31e24" style="border-radius: 100px;">
                        <a href="{{browse_url}}" target="_blank" style="padding: 12px 30px; color: #ffffff; font-size: 13px; font-weight: bold; text-decoration: none; display: inline-block;">
                            {{t 'emails.property_saved_search.button'}}
                        </a>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
