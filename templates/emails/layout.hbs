<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <!-- Prevent iOS Mail from forcing a white page background -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
</head>
<body style="margin:0; padding:0; background-color:#020617;">
    <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#020617" style="background-color: #020617; width: 100%;">
        <tr>
            <td align="center" style="padding: 40px 10px; background-color: #020617;">
                
                <!-- Main card -->
                <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#0b1120" style="max-width: 450px; background-color: #0b1120; border: 1px solid #1e293b; border-radius: 48px; border-collapse: separate;">
                    
                    <!-- Header -->
                    <tr>
                        <td align="center" style="padding: 35px 20px 25px 20px; background-color: #0b1120; border-radius: 48px 48px 0 0;">
                            <table border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" style="background-color: #000000; border-radius: 100px; border: 1px solid #e31e24;">
                                <tr>
                                    <td align="center" style="padding: 12px 35px; background-color: #000000; border-radius: 100px;">
                                        {{{logo_img}}}
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Body -->
                    <tr>
                        <td align="center" style="padding: 0 30px 35px 30px; background-color: #0b1120; font-family: Arial, Helvetica, sans-serif;">
                            <div style="display: block;">
                                {{{body}}}
                            </div>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="padding: 0 25px 35px 25px; background-color: #0b1120; border-radius: 0 0 48px 48px;">
                            <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" style="background-color: #000000; border-radius: 35px; border: 1px solid #1e293b;">
                                <tr>
                                    <td align="center" style="padding: 25px; background-color: #000000; border-radius: 35px;">
                                        <p style="margin: 0; color: #e31e24; font-size: 11px; font-weight: bold; text-transform: uppercase; letter-spacing: 2px; font-family: Arial, sans-serif;">
                                            {{t 'emails.common.tagline'}}
                                        </p>
                                        <p style="margin: 8px 0 0 0; color: #475569; font-size: 10px; line-height: 1.5; font-family: Arial, sans-serif;">
                                            &copy; 2026  Strug Intermediaries Inc. {{t 'emails.common.rights_reserved'}}
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

            </td>
        </tr>
    </table>
</body>
</html>
