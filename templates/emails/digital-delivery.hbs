<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, sans-serif;">
    <tr>
        <td align="center" style="padding-bottom: 12px; background-color: #0b1120;">
            <font color="#e31e24" style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 3px;">PURCHASE SUCCESS</font>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 20px; background-color: #0b1120;">
            <h1 style="margin: 0; color: #ffffff; font-size: 30px; font-weight: bold;">{{t 'emails.digital.title'}}</h1>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 35px; background-color: #0b1120;">
            <p style="margin: 0; color: #94a3b8; font-size: 16px; line-height: 1.6;">{{t 'emails.digital.instruction'}}</p>
        </td>
    </tr>
    <tr>
        <td align="center" bgcolor="#e31e24" style="border-radius: 100px; padding: 15px 40px;">
            <a href="{{download_url}}" target="_blank" style="color: #ffffff; font-size: 16px; font-weight: bold; text-decoration: none;">{{t 'emails.digital.button'}}</a>
        </td>
    </tr>
</table>