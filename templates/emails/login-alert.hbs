<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, sans-serif;">
    <tr>
        <td align="center" style="padding-bottom: 12px; background-color: #0b1120;">
            <font color="#e31e24" style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 3px;">{{t 'emails.login_alert.tag'}}</font>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 15px; background-color: #0b1120;">
            <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: bold;">{{t 'emails.login_alert.title'}}</h1>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 25px; background-color: #0b1120;">
            <p style="margin: 0; color: #94a3b8; font-size: 15px; line-height: 1.6;">{{t 'emails.login_alert.instruction'}}</p>
        </td>
    </tr>
    <tr>
        <td align="center" style="background-color: #0b1120;">
            <!-- Device Info Island -->
            <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" style="background-color: #000000; border-radius: 20px; border: 1px solid #1e293b;">
                <tr>
                    <td style="padding: 20px; text-align: left;">
                        <p style="margin: 0; color: #ffffff; font-size: 14px;"><b>{{t 'emails.login_alert.device'}}:</b> {{device_name}}</p>
                        <p style="margin: 5px 0 0 0; color: #ffffff; font-size: 14px;"><b>{{t 'emails.login_alert.time'}}:</b> {{login_time}}</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-top: 30px; background-color: #0b1120;">
            <p style="margin: 0; font-size: 13px; color: #ff4d4d; font-weight: bold;">{{t 'emails.login_alert.not_you'}}</p>
        </td>
    </tr>
</table>