<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, sans-serif;">
    <tr>
        <td align="center" style="padding-bottom: 12px; background-color: #0b1120;">
            <font color="#e31e24" style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 3px;">{{t 'emails.services.tag'}}</font>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 15px; background-color: #0b1120;">
            <h1 style="margin: 0; color: #ffffff; font-size: 26px; font-weight: bold;">{{title}}</h1>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 30px; background-color: #0b1120;">
            <p style="margin: 0; color: #94a3b8; font-size: 15px; line-height: 1.6;">{{message}}</p>
        </td>
    </tr>

    <!-- Details Island -->
    <tr>
        <td align="center" style="background-color: #0b1120;">
            <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" style="background-color: #000000; border-radius: 20px; border: 1px solid #1e293b;">
                <tr>
                    <td style="padding: 25px;">
                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                            <tr>
                                <td style="color: #64748b; font-size: 13px;">{{t 'emails.services.labels.service'}}</td>
                                <td align="right" style="color: #ffffff; font-size: 14px; font-weight: bold;">{{service_name}}</td>
                            </tr>
                            <tr><td colspan="2" style="padding-top: 10px; border-bottom: 1px solid #1e293b;"></td></tr>
                            <tr>
                                <td style="color: #64748b; font-size: 13px; padding-top: 10px;">{{#if isProvider}}{{t 'emails.services.labels.customer'}}{{else}}{{t 'emails.services.labels.provider'}}{{/if}}</td>
                                <td align="right" style="color: #ffffff; font-size: 14px; padding-top: 10px;">{{other_party_name}}</td>
                            </tr>
                            <tr>
                                <td style="color: #64748b; font-size: 13px; padding-top: 5px;">{{t 'emails.services.labels.date'}}</td>
                                <td align="right" style="color: #ffffff; font-size: 14px; padding-top: 5px;">{{date}}</td>
                            </tr>
                            <tr>
                                <td style="color: #64748b; font-size: 13px; padding-top: 5px;">{{t 'emails.services.labels.time'}}</td>
                                <td align="right" style="color: #ffffff; font-size: 14px; padding-top: 5px;">{{time}}</td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>