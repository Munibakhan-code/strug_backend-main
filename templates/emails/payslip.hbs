<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, sans-serif;">
    <tr>
        <td align="center" style="padding-bottom: 12px; background-color: #0b1120;">
            <font color="#e31e24" style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 3px;">{{t 'emails.payroll.tag'}}</font>
        </td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 25px; background-color: #0b1120;">
            <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: bold;">{{t 'emails.payroll.title'}}</h1>
        </td>
    </tr>

    <!-- Salary Island -->
    <tr>
        <td align="center" style="background-color: #0b1120;">
            <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" style="background-color: #000000; border-radius: 24px; border: 1px solid #1e293b;">
                <tr>
                    <td style="padding: 25px;">
                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                            <!-- Net Salary -->
                            <tr>
                                <td style="color: #94a3b8; font-size: 14px;">{{t 'emails.payroll.net_salary'}}</td>
                                <td align="right" style="color: #ffffff; font-size: 18px; font-weight: bold;"> {{currency}} {{net_salary}}</td>
                            </tr>
                            <tr><td colspan="2" style="border-bottom: 1px solid #1e293b; padding-top: 15px; margin-bottom: 15px;"></td></tr>
                            
                            <!-- Breakdown -->
                            <tr>
                                <td style="color: #94a3b8; font-size: 13px; padding-top: 10px;">{{t 'emails.payroll.ot'}}</td>
                                <td align="right" style="color: #ffffff; font-size: 13px;">+ LKR {{ot}}</td>
                            </tr>
                            <tr>
                                <td style="color: #94a3b8; font-size: 13px; padding-top: 5px;">{{t 'emails.payroll.bonus'}}</td>
                                <td align="right" style="color: #ffffff; font-size: 13px;">+ LKR {{bonus}}</td>
                            </tr>
                            <tr>
                                <td style="color: #94a3b8; font-size: 13px; padding-top: 5px;">{{t 'emails.payroll.epf'}}</td>
                                <td align="right" style="color: #ff4d4d; font-size: 13px;">- LKR {{epf_amount}}</td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>

    <tr>
        <td align="center" style="padding-top: 35px; background-color: #0b1120;">
            <p style="margin: 0; font-size: 14px; color: #94a3b8; line-height: 1.6;">{{t 'emails.payroll.thanks'}}</p>
        </td>
    </tr>
</table>
